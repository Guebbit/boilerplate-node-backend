# An install script runs only if package.json `allowScripts` names it.
# https://docs.npmjs.com/cli/using-npm/config#strict-allow-scripts
strict-allow-scripts=true
# An older npm would silently ignore the line above, so refuse to run on one.
engine-strict=true
# Write `allowScripts` entries by package name, not name@version: a grouped bump then stays approved.
# https://docs.npmjs.com/cli/v11/commands/npm-install-scripts
allow-scripts-pin=false

# npm refuses a version released less than 7 days ago; a one-off override is `npm install <pkg> --min-release-age=0`.
# https://docs.npmjs.com/cli/v11/using-npm/config#min-release-age
min-release-age=7
