# Dependencies (installed inside the container)
node_modules

# Version control
.git

# Secrets
.env

# Per-client deployment config, one directory each. Mounted at runtime, never baked into the image.
clients

# The second machine's secrets (compose.backup-server.yaml), kept out of every build context.
backup-server

# IDE
.idea

# 2brain's generated wiki (see CLAUDE.md): committed so a teammate without 2brain installed can
# still read it, but nothing at runtime or in the image build reads it.
.2brain

# App build output
dist

# VitePress build output and dep cache (both rebuilt inside the docs container)
docs/.vitepress/dist
docs/.vitepress/cache

# Test and analysis output — test/mutation reports, Stryker's own sandbox, per-run
# Mongo data. None of it is read at runtime, and `tmp/reports/` alone is ~20 MB of mutation HTML —
# every megabyte here is copied into the build context on every single build.
tmp

# Generated API-client collection for Bruno: developer tooling rebuilt by
# `npm run contracts:bundle -- bruno`. Only
# `tests/cross-cutting/contract-bundles.test.ts` reads them, and the image build runs no tests,
# only `ts-check`.
contract.generated.bruno.yml

# Generated from openapi.yaml fragments by `postinstall` — see .gitignore. A stale host copy would
# be overwritten anyway (`gen:api` starts with `rm -rf ./api.generated`), but there is no reason to upload it
# to the build daemon first.
/openapi.yaml
/api.generated/

# Logs
*.log

# Local env files (`.env.local`, `.env.production`, ...) and anything a user uploaded. The committed
# `seed/` and `system/` images ARE the product, so they stay — the same rule as `.gitignore`.
.env*
# `.env-example` is the template `first-run.test.ts` reads inside the container-gate image.
!.env-example
public/images/*
!public/images/seed/
!public/images/system/
