# Shared by `app`, `cron` and `setup` (they all read the same configuration, as in
# compose.production.yaml). Plain values only: a secret is a file under /run/secrets, named by a
# `NODE_*_FILE` variable below, and never a value in here.
NODE_ENV=production
NODE_PORT=3000
NODE_SERVICE_NAME=api

# Backing services, by their Service names. No passwords and no TLS on the rig: one namespace on
# one node. A real cluster sets its own URIs (a managed Mongo needs its own topology and TLS).
NODE_DB_URI=mongodb://mongo-0.mongo:27017/api?replicaSet=rs0
# Both point at the one Redis (`noeviction`, see cache.yaml). Production keeps them apart on
# purpose: compose.production.yaml gives rate-limit counters their own instance.
NODE_REDIS_URL=redis://cache:6379
NODE_RATE_LIMIT_REDIS_URL=redis://cache:6379
# No NODE_RABBITMQ_URL: with no broker the app falls back to running its jobs in the process.

# Production refuses to boot without these (the same set docker/deploy-drill.sh writes). The values
# are placeholders for a local rig, not a template for a deployment. NODE_URL, NODE_FRONTEND_URL and
# NODE_CORS_ORIGIN are the ConfigMap `edge-env`: they name the address clients reach the API at.
NODE_SUPPORT_EMAIL=support@example.com
NODE_LEGAL_NAME=Rig S.r.l.
NODE_LEGAL_STREET=Via Roma 1
NODE_LEGAL_CITY=Bologna
NODE_LEGAL_ZIP=40121
NODE_LEGAL_COUNTRY=IT
NODE_LEGAL_PHONE=+39 051 555 0100
NODE_SHOP_TIMEZONE=Europe/Rome
NODE_VAT_RATE_DEFAULT=0.22
NODE_VAT_RATE_REDUCED=0.10
NODE_SMTP_HOST=smtp.invalid
NODE_SMTP_USER=rig@example.com
NODE_SMTP_SENDER=Rig <rig@example.com>

# One proxy hop (the Gateway's Envoy) sits in front of the app: the client address is the
# X-Forwarded-For entry it adds. Without this every request shares the proxy's address.
NODE_TRUST_PROXY_HOPS=1
# The steady load of a drill would spend the default per-address budget and read 429.
NODE_RATE_LIMIT_MAX=1000000
# No captcha provider on a local rig.
NODE_ANTIBOT_PROVIDER=none

# Lame-duck delay between "not ready" and closing the listener, so the endpoint is out of the
# Service before the app stops accepting. terminationGracePeriodSeconds (30) must stay above
# delay + NODE_GRACEFUL_SHUTDOWN_TIMEOUT_MS (15 s default): src/infrastructure/runtime/config.ts.
NODE_SHUTDOWN_DELAY_MS=5000
# The heap stays under the container's 1Gi limit (app.yaml), so Node collects before the OOM killer acts.
NODE_OPTIONS=--max-old-space-size=640

# Secret files, mounted from the `app-secrets` Secret. Empty means unset (secret-files.ts).
NODE_TOKEN_ACCESS_FILE=/run/secrets/token_access
NODE_TOKEN_REFRESH_FILE=/run/secrets/token_refresh
NODE_TOTP_ENCRYPTION_KEY_FILE=/run/secrets/totp_encryption_key
NODE_PII_ENCRYPTION_KEY_FILE=/run/secrets/pii_encryption_key
NODE_WEBHOOK_SECRET_ENCRYPTION_KEY_FILE=/run/secrets/webhook_secret_encryption_key
NODE_PSEUDONYM_KEY_FILE=/run/secrets/pseudonym_key
NODE_METRICS_TOKEN_FILE=/run/secrets/metrics_token
NODE_DEVICE_COOKIE_SECRET_FILE=/run/secrets/device_cookie_secret
NODE_SMTP_PASS_FILE=/run/secrets/smtp_password
NODE_PAYMENT_WEBHOOK_SECRET_FILE=/run/secrets/payment_webhook_secret
NODE_OAUTH_GOOGLE_CLIENT_SECRET_FILE=/run/secrets/oauth_google_client_secret
NODE_OAUTH_GITHUB_CLIENT_SECRET_FILE=/run/secrets/oauth_github_client_secret
NODE_ANTIBOT_ALTCHA_SECRET_FILE=/run/secrets/antibot_altcha_secret
NODE_ANTIBOT_TURNSTILE_SECRET_FILE=/run/secrets/antibot_turnstile_secret
NODE_POSTHOG_PERSONAL_API_KEY_FILE=/run/secrets/posthog_personal_api_key
