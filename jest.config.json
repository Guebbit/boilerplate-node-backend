{
    "preset": "ts-jest",
    "clearMocks": true,
    "coverageProvider": "v8",
    "testEnvironment": "node",
    "testMatch": ["**/tests/**/*.test.ts"],
    "testPathIgnorePatterns": ["/node_modules/", "<rootDir>/.stryker-tmp/"],
    "modulePathIgnorePatterns": ["<rootDir>/.stryker-tmp/"],
    "collectCoverageFrom": ["src/**/*.ts", "!src/types/**", "!src/**/*.d.ts"],
    "coverageThreshold": {
        "src/core/http/": { "statements": 70, "branches": 70, "functions": 70, "lines": 70 },
        "src/middlewares/": { "statements": 70, "branches": 70, "functions": 70, "lines": 70 },
        "src/models/": { "statements": 70, "branches": 70, "functions": 70, "lines": 70 },
        "src/services/": { "statements": 70, "branches": 70, "functions": 70, "lines": 70 }
    },
    "setupFiles": ["<rootDir>/tests/helpers/setup.ts"],
    "testTimeout": 30000,
    "transform": {
        "^.+\\.tsx?$": [
            "ts-jest",
            {
                "tsconfig": "tsconfig.jest.json"
            }
        ]
    },
    "moduleNameMapper": {
        "^@api/(.*)$": "<rootDir>/api/$1",
        "^@types$": "<rootDir>/src/types",
        "^@controllers/(.*)$": "<rootDir>/src/controllers/$1",
        "^@services/(.*)$": "<rootDir>/src/services/$1",
        "^@repositories/(.*)$": "<rootDir>/src/repositories/$1",
        "^@models/(.*)$": "<rootDir>/src/models/$1",
        "^@middlewares/(.*)$": "<rootDir>/src/middlewares/$1",
        "^@jobs/(.*)$": "<rootDir>/src/jobs/$1",
        "^@core/(.*)$": "<rootDir>/src/core/$1"
    }
}
