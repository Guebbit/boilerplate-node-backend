{
    "compilerOptions": {
        "target": "ES6",
        "lib": ["ES2023"],
        "module": "es2020",
        "paths": {
            "@types": ["./src/types"],
            "@api/*": ["./api/*"],
            "@tests/*": ["./tests/support/*"],
            "@app/*": ["./src/app/*"],

            "@infrastructure/*": ["./src/infrastructure/*"],
            "@kernel/*": ["./src/kernel/*"],
            "@modules/*": ["./src/modules/*"]
        },
        "strict": true,
        "composite": true,
        "noEmit": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "sourceMap": true,
        "forceConsistentCasingInFileNames": true,
        "noPropertyAccessFromIndexSignature": false,
        "resolveJsonModule": true,
        "moduleResolution": "bundler",
        "verbatimModuleSyntax": true,
        "outDir": "./dist",
        "types": ["node", "jest"],
        "typeRoots": ["./src/types", "./node_modules/@types"]
    },
    /*
     * The per-module dev directory is excluded — spelled in words here, because a glob's
     * wildcard-then-slash would close this comment — since `resolveJsonModule` puts `src` JSON in
     * the program too, and half a Mockoon collection parses as neither JSON nor TypeScript.
     */
    "exclude": ["node_modules", "src/modules/*/dev/**"],
    "include": [
        "api/**/*.ts",
        "src/*.ts",
        "src/**/*.ts",
        "src/**/*.json",
        "tests/**/*.ts",
        "db/**/*.ts",
        "db/seeds/dataset.json",
        "scripts/**/*.ts"
    ]
}
