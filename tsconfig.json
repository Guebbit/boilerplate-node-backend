{
    "compilerOptions": {
        "target": "ES6",
        "lib": ["ES2023"],
        "module": "es2020",
        "paths": {
            "@types": ["./src/types"],
            "@api/*": ["./api/*"],
            "@tests/*": ["./tests/support/*"],
            "@app/*": ["./src/app/*"],

            "@infrastructure/*": ["./src/infrastructure/*"],
            "@kernel/*": ["./src/kernel/*"],
            "@modules/*": ["./src/modules/*"]
        },
        "strict": true,
        "composite": true,
        "noEmit": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "sourceMap": true,
        "forceConsistentCasingInFileNames": true,
        "noPropertyAccessFromIndexSignature": false,
        "resolveJsonModule": true,
        "moduleResolution": "bundler",
        "verbatimModuleSyntax": true,
        "outDir": "./dist",
        "types": ["node", "jest"],
        "typeRoots": ["./src/types", "./node_modules/@types"]
    },
    "exclude": ["node_modules"],
    "include": [
        "api/**/*.ts",
        "src/*.ts",
        "src/**/*.ts",
        "src/**/*.json",
        "tests/**/*.ts",
        "db/**/*.ts",
        "db/demo/demo-data.json",
        "eslint/**/*.ts",
        "scripts/**/*.ts",
        "ops/**/*.ts",
        "shared/contracts/*.ts"
    ]
}
