# ============================================================
#  Boilerplate Node Backend — environment configuration
# ============================================================
# Copy to `.env` and adjust.
#
# Conventions:
#   - every comment sits ABOVE the variable it explains
#   - `#VAR=` means optional; the value shown is the default
#   - `MUST SET` means the app refuses to boot, or starts and is wrong
#   - a variable whose name already says it carries no comment
#   - the app reads every variable unless its section says who else does
#   - each section links the page that explains it in full
#
# Four parts, in the order you need them:
#   A. must set          — nothing runs, or nothing is correct, until these are right
#   B. review before deploying  — sane defaults, wrong ones for a real deployment
#   C. optional subsystems      — off unless configured
#   D. not read by the app      — docker-compose, npm scripts, third-party libraries
# ============================================================


# ============================================================
# ============================================================
#  PART A — MUST SET
# ============================================================
# ============================================================


# ============================================================
#  A1. Core runtime
# ============================================================

NODE_ENV=development

# Port app.listen binds.
NODE_PORT=3000

# Host app.listen binds — unset means every interface. The dev docker compose stack instead
# defaults this to loopback for its own port publishing; set to override either.
#NODE_HOST=

# MUST SET — base URL for every outgoing link: password-reset emails, account-deletion
# confirmations, OAuth callbacks. Boot refuses an empty value, because a wrong one is a broken
# link in someone's inbox and nothing logs it.
NODE_URL=http://localhost:3000/

# MUST SET in production — origins allowed to call this API, comma-separated. The code default is
# http://localhost:8080, which is right for a developer and never right for a deployment, so boot
# refuses an empty value when NODE_ENV=production.
NODE_CORS_ORIGIN=http://localhost:8080,http://localhost:8085,http://localhost:3000

# Directory served as static files.
NODE_PUBLIC_PATH=public

# Max JSON/urlencoded request body.
NODE_JSON_BODY_LIMIT=100kb

# How long a client may take to SEND a request; neither bounds the handler.
# Node's own defaults are 60000 / 300000. See: docs/tools/security.md
NODE_HTTP_HEADERS_TIMEOUT_MS=15000
NODE_HTTP_REQUEST_TIMEOUT_MS=120000

# Raise ABOVE the idle timeout of the proxy in front of this API, or the proxy
# reuses a socket the server already closed and answers 502.
NODE_HTTP_KEEP_ALIVE_TIMEOUT_MS=5000


# ============================================================
#  A2. Database (MongoDB)
#  See: docs/tools/mongodb-mongoose.md
# ============================================================

# A full URI wins outright. Blanking it is how `npm run host` falls through to the components
# below and reaches a containerised database while keeping the database name from this file.
NODE_DB_URI=mongodb://database:27017/boilerplate-node-backend

NODE_MONGODB_HOST=database
NODE_MONGODB_PORT=27017
NODE_MONGODB_NAME=boilerplate-node-backend


# ============================================================
#  A3. Cache (Redis)
#  See: docs/tools/redis-cache.md
# ============================================================

# Same precedence as the database above: the URI wins, the parts are the `npm run host` path.
NODE_REDIS_URL=redis://redis:6379
NODE_REDIS_HOST=redis
NODE_REDIS_PORT=6379

# 0 serves every request uncached.
NODE_REDIS_CACHE_ENABLED=1

NODE_REDIS_CACHE_PREFIX=boilerplate-node-backend

# Longest cache TTL allowed outside production, in seconds. 0 disables the cap.
#NODE_REDIS_CACHE_DEV_TTL_MAX=30

# Largest response body the cache will store, in bytes. A larger one is still served, just not cached.
#NODE_REDIS_CACHE_MAX_BYTES=262144


# ============================================================
#  A4. Authentication & tokens
#  See: docs/tools/security.md and docs/modules/account-sessions.md
# ============================================================

# MUST SET — boot refuses this placeholder. Comma-separated ring, newest first: "new,old" signs
# with "new", verifies either. Rotation procedure: docs/tools/security.md#signing-key-rotation.
NODE_TOKEN_ACCESS=your-access-token-secret-here

# MUST SET — boot refuses this placeholder. Same ring shape as NODE_TOKEN_ACCESS above.
NODE_TOKEN_REFRESH=your-refresh-token-secret-here

# MUST SET — encrypts device secrets and keys the HMAC of delivered codes. Boot refuses this
# placeholder: a secret encrypted under it is readable by anyone who has this repository.
# See: docs/tools/security.md#two-factor-authentication
NODE_TOTP_ENCRYPTION_KEY=your-totp-encryption-key-here

# MUST SET — encrypts GDPR-flagged PII at rest: an address-book entry's fullName/street/city/
# zip/country/phone, and a user's own phone. Boot refuses this placeholder, same reasoning as
# NODE_TOTP_ENCRYPTION_KEY above. Same ring format: docs/tools/security.md#database-credential-and-key-rotation.
NODE_PII_ENCRYPTION_KEY=your-pii-encryption-key-here

# WARNING: owned by the webhooks module — delete it when removing the module (docs/modules/webhooks.md)
# MUST SET — encrypts a webhook subscription's secret ring at rest, AES-256-GCM. Boot refuses
# this placeholder: a ring encrypted under it lets anyone who has this repository forge deliveries
# your consumers would accept as genuine. See: docs/modules/webhooks.md
NODE_WEBHOOK_SECRET_ENCRYPTION_KEY=your-webhook-secret-encryption-key-here

# Seconds. Unset uses the default shown — never zero, which would expire a token as it is signed.
#NODE_TOKEN_ACCESS_TIME=600

# Seconds, one per "remember me" tier: 7 days, 30 days, a year.
#NODE_TOKEN_REFRESH_TIME_SHORT=604800
#NODE_TOKEN_REFRESH_TIME_MEDIUM=2592000
#NODE_TOKEN_REFRESH_TIME_LONG=31536000

# How long a rotated refresh token is still honoured, ms — absorbs two tabs refreshing at once.
NODE_TOKEN_ROTATION_GRACE_MS=10000

# How long a rotated-away token is REMEMBERED, ms, so replaying it is still detected as theft and
# revokes every session. Must exceed the grace window above — the app refuses to boot otherwise.
# A day costs ~144 retained rows per active session; a refresh token's full lifetime would reach
# ~52,500 on the one-year tier. See docs/modules/account-sessions.md#refresh-rotation.
NODE_TOKEN_REUSE_WINDOW_MS=86400000

# Step-up windows, seconds: how recently a caller must have proved themselves.
# Critical covers money and destruction; sensitive covers identity and sessions.
NODE_REAUTH_TIME_CRITICAL=300
NODE_REAUTH_TIME_SENSITIVE=900

# Code guesses allowed against one login challenge.
NODE_MFA_CHALLENGE_MAX=5

# Codes delivered per challenge — a first send plus two resends.
NODE_MFA_SEND_MAX=3

# How long a password-reset link works, ms. Shorten it; lengthening widens a stolen-mailbox window.
NODE_PASSWORD_RESET_TTL_MS=3600000

# How long an email verification / email-change link works, ms.
NODE_EMAIL_VERIFY_TTL_MS=86400000


# ============================================================
# ============================================================
#  PART B — REVIEW BEFORE DEPLOYING
# ============================================================
# ============================================================


# ============================================================
#  B1. Rate limiting
#  See: docs/tools/security.md#the-rate-limit-budgets
# ============================================================

# Reverse proxies in front of the API. Too low buckets every caller together;
# too high lets a caller forge X-Forwarded-For. See: docs/tools/security.md#trust-proxy-and-the-two-ways-to-get-it-wrong
NODE_TRUST_PROXY_HOPS=0

# The global burst brake: window in ms, then requests per address inside it.
NODE_RATE_LIMIT_WINDOW_MS=60000
NODE_RATE_LIMIT_MAX=100

# FAILED credential attempts per window — three independent buckets: per account, per address,
# and per address BLOCK (an IPv4 /24, an IPv6 /64 — a proxy pool or one IPv6 customer otherwise
# reads as an unbounded number of callers). Only failures count.
NODE_AUTH_RATE_LIMIT_MAX=10
NODE_AUTH_RATE_LIMIT_ADDRESS_MAX=30
NODE_AUTH_RATE_LIMIT_BLOCK_MAX=100

# Signups per window — per submitted email, per address, per address block. Spent by SUCCESS: a
# Sybil signup gets a 201, so only a budget spent on success bounds it.
NODE_SIGNUP_RATE_LIMIT_MAX=5
NODE_SIGNUP_RATE_LIMIT_ADDRESS_MAX=15
NODE_SIGNUP_RATE_LIMIT_BLOCK_MAX=40

# Password-reset requests per window — same three keys and reasoning as signup: the endpoint
# always answers 200 (prevents account enumeration), so only a success-spent budget bounds it.
NODE_RESET_RATE_LIMIT_MAX=5
NODE_RESET_RATE_LIMIT_ADDRESS_MAX=15
NODE_RESET_RATE_LIMIT_BLOCK_MAX=40

# Contact-form posts per window — per address, per submitted email, per address block. Spent by
# SUCCESS, since abuse also gets a 201.
NODE_SUBMISSION_RATE_LIMIT_MAX=5
NODE_SUBMISSION_RATE_LIMIT_EMAIL_MAX=5
NODE_SUBMISSION_RATE_LIMIT_BLOCK_MAX=20

# Image uploads per address per window. Spent by success, same reasoning.
NODE_UPLOAD_RATE_LIMIT_MAX=20

# GET /orders/:id/invoice renders per ACCOUNT per window — every hit spawns a Chromium launch.
NODE_INVOICE_RATE_LIMIT_MAX=20

# Payment webhook deliveries per address per window. Spent by success, same reasoning — the caller
# is a machine authenticated by its signature, not this budget's job.
NODE_PAYMENT_WEBHOOK_RATE_LIMIT_MAX=60

# POST /payments/:id/confirm per ACCOUNT per HOUR (fixed window, not NODE_RATE_LIMIT_WINDOW_MS) —
# card-testing velocity. Attempts count every outcome; declines count PAYMENT_DECLINED only.
NODE_PAYMENT_CONFIRM_RATE_LIMIT_MAX=5
NODE_PAYMENT_DECLINE_RATE_LIMIT_MAX=3

# POST /account/password/check per address per window — unauthenticated, and every call may
# trigger an outbound HIBP lookup. Every request counts, same reasoning as the submission budget.
NODE_PASSWORD_CHECK_RATE_LIMIT_MAX=20

# Raise the budgets above that spend on success to ~1000 when serving the frontend's
# `test:e2e:live`, never in a deployment.

# Where the limiters COUNT. 0 counts in memory — with no Redis the counters are per process,
# which multiplies every budget above by the worker count. The app logs an error when that happens.
NODE_RATE_LIMIT_REDIS_ENABLED=1

# Unset falls back to NODE_REDIS_URL, then NODE_REDIS_HOST + NODE_REDIS_PORT.
NODE_RATE_LIMIT_REDIS_URL=
NODE_RATE_LIMIT_REDIS_PREFIX=rate-limit


# ============================================================
#  B2. Localisation
#  See: docs/tools/i18n.md
# ============================================================

# The language used outside a request — jobs, workers, boot.
NODE_DEFAULT_LOCALE=en

# The language used when Accept-Language matches nothing supported.
NODE_FALLBACK_LOCALE=en

# Unset = every src/locales/*.json.
#NODE_SUPPORTED_LOCALES=en,it

# A tenant is one audience's set of admin-edited translation overrides, layered over the
# deployed files. The backend's own are never served to clients; the frontend's are what
# GET /locales/{locale}/messages builds when the client names no tenant of its own.
# EXTRA takes comma-separated `id=Label` pairs and is listed by GET /locales/tenants.
#NODE_LOCALE_TENANT_BACKEND=demo-be
#NODE_LOCALE_TENANT_FRONTEND=demo-fe
#NODE_LOCALE_TENANTS_EXTRA=

# How often a worker re-reads those overrides, ms — bounds how long the others may still
# answer with the previous text.
#NODE_LOCALE_OVERRIDE_REFRESH_MS=60000


# ============================================================
#  B3. Uploads & images
#  See: docs/tools/image-processing.md
# ============================================================

# multer's own default is unlimited.
NODE_MAX_UPLOAD_BYTES=5242880

# Where an upload waits while the request is checked. NOT inside NODE_PUBLIC_PATH.
# Unset = <system temp>/node-api-uploads.
#NODE_UPLOAD_STAGING_PATH=/var/tmp/node-api-uploads

# Where un-sanitised bytes sit until the digest pipeline clears them. Resolved against the
# WORKING DIRECTORY when relative, so it lands wherever the process was launched from. A real
# deployment MUST set this to its own mounted volume — the unset default lives under tmp/, which
# is a local-dev convenience, not a durability guarantee.
#NODE_QUARANTINE_PATH=tmp/quarantine

# How long a quarantine file is left alone before `npm run reap:quarantine` counts it abandoned.
# Long enough that a broker outage lasting a normal maintenance window does not lose anything.
#NODE_QUARANTINE_RETENTION_HOURS=24

# Served while a digest is still running, so a record has an image between upload and promotion.
#NODE_PENDING_IMAGE_URL=/images/system/pending.png
#NODE_PENDING_THUMBNAIL_URL=/images/system/pending-thumb.webp

# Used when a record carries no image of its own. Unset (the default) falls back to the local
# /images/system/placeholder-{product,user}.png, same convention as NODE_PENDING_IMAGE_URL above.
#NODE_DEFAULT_IMAGE_PRODUCT=/images/system/placeholder-product.png
#NODE_DEFAULT_IMAGE_USER=/images/system/placeholder-user.png

# Refuses to decode an image past this many pixels, before any resize runs.
#NODE_IMAGE_MAX_INPUT_PIXELS=50000000

# Downscales a stored image to fit this box. Below it, a resize is a no-op.
#NODE_IMAGE_MAX_DIMENSION=2048

# Same, for the generated thumbnail.
#NODE_IMAGE_THUMBNAIL_DIMENSION=320


# ============================================================
#  B4. Email (SMTP)
#  See: docs/tools/email-and-rendering.md
# ============================================================
# Optional as a whole — unset, the email second factor reports itself unavailable. But
# ALL OR NOTHING: boot refuses a NODE_SMTP_HOST set without USER, PASS and SENDER, because a
# half-configured transport only fails when a real user asks to reset a password.

# How an email is treated. One named setting rather than a condition per caller, the way Laravel
# spells it `MAIL_MAILER` and Symfony `MAILER_DSN`.
#   smtp    hand it to the server below. The default, and what a deployment saying nothing gets.
#   log     render it and log the send, opening no socket. For a seeder, a staging box, or any
#           environment that should exercise the templates without mailing anyone.
#   outbox  keep it in memory for GET /__test/emails.
# Two cases are not yours to set: the demo profile always uses its outbox (that route IS its
# control surface) and a test run always uses `log` (a suite must never reach a real server).
#NODE_MAIL_TRANSPORT=smtp

NODE_SMTP_HOST=mail.guebbit.com
NODE_SMTP_PORT=465
NODE_SMTP_USER=noreply@guebbit.com
NODE_SMTP_PASS=emailpassword
NODE_SMTP_SENDER="Guebbit <noreply@guebbit.com>"
NODE_SMTP_NAME=hostgator

# Recipient of contact / feedback notifications. Unset falls back to NODE_SMTP_SENDER.
NODE_CONTACT_NOTIFY_EMAIL=admin@guebbit.com

# Unset = the EJS templates shipped with the app.
#NODE_EMAIL_TEMPLATES_DIR=/srv/email-templates


# ============================================================
#  B5. Logging
#  See: docs/tools/winston.md
# ============================================================

# error | warn | info | http | verbose | debug | silly.
# Unset = info in production, debug elsewhere.
NODE_LOG_LEVEL=debug

# Tags every log entry — tells services apart in a shared aggregator.
NODE_SERVICE_NAME=api

# How email, ip, phone, street, zip and fullName are treated: hash | redact | plain.
NODE_LOG_PERSONAL_FIELDS=hash


# ============================================================
#  B6. Data retention & privacy
#  See: docs/theory/data-protection.md and docs/reference/ops.md
# ============================================================
# Each backs a Mongo TTL index. Changing one on an existing database needs a migration
# (collMod): Mongo will not alter an already-created TTL index.

# Days. Affects only the queryable copy behind GET /observability/audit —
# the audit log FILE is the compliance record and is untouched.
NODE_AUDIT_RETENTION_DAYS=90

# Days. 24 months sits inside the common limitation periods for a commercial dispute.
NODE_FEEDBACK_RETENTION_DAYS=730

# Days an abandoned cart survives.
NODE_CART_RETENTION_DAYS=365

# Days a lease document survives with no acquisition before Mongo's TTL index removes it —
# garbage collection for a job retired from the crontab entirely, unrelated to the ttlMs a
# running job's own lease is held for.
NODE_LEASE_RETENTION_DAYS=30

# Days of no login before `npm run reap:inactive-accounts` warns, soft-deletes, then
# hard-deletes an account. 0 disables it.
NODE_INACTIVE_ACCOUNT_DAYS=0

# Days after account erasure before `npm run reap:orders` scrubs an order's remaining PII.
# The row itself is never deleted.
NODE_ORDER_PII_RETENTION_DAYS=3650

# Where a rendered invoice may be cached. Resolved against the WORKING DIRECTORY when relative,
# same as NODE_QUARANTINE_PATH — and, like it, must stay OUTSIDE NODE_PUBLIC_PATH: an invoice
# carries personal and financial data, and must only be reachable through the authenticated
# GET /orders/{id}/invoice, never as a guessable static url. A real deployment MUST set this to
# its own mounted volume — the unset default lives under tmp/, a local-dev convenience only.
#NODE_INVOICE_CACHE_PATH=tmp/storage/invoices

# Minutes a rendered invoice stays cached — long enough to absorb one person's download-view-
# redownload burst, never long enough to make the cache a second copy of the order's own retention.
# Forced to 0 (never cache) under demo mode or NODE_ENV=test, whatever this says.
#NODE_INVOICE_CACHE_TTL_MINUTES=5

# The Claim Check store an email attachment's bytes travel through — the queue message carries
# only a key. Resolved against the WORKING DIRECTORY when relative, and, like the invoice cache,
# must stay OUTSIDE NODE_PUBLIC_PATH. A real deployment MUST set this to its own mounted volume —
# the unset default lives under tmp/, a local-dev convenience only.
#NODE_MAIL_SPOOL_PATH=tmp/storage/mail-spool

# How long a spooled attachment is left alone before `npm run reap:mail-spool` counts it abandoned.
# A mail job settles in seconds; anything still here past this hour is one that died mid-flight.
# Must exceed NODE_QUEUE_MAX_ATTEMPTS x NODE_QUEUE_RETRY_DELAY_SECONDS, or the reaper can delete an
# attachment a queued retry still needs.
#NODE_MAIL_SPOOL_RETENTION_HOURS=1

# Days a payment attempt may sit untouched before `npm run reap:payments` deletes it. Only
# attempts that never reached succeeded/refunded qualify — a settled payment is never deleted.
NODE_PAYMENT_ABANDONED_RETENTION_DAYS=30

# How long a cancelled order's refund gets before `npm run sweep:order-effects` retries it.
# A grace window, not a deadline: the refund normally settles milliseconds after the cancel, and
# this only has to outlast a slow one.
#NODE_ORDER_EFFECT_RETRY_MINUTES=5

# Include the caller's feedback tickets, matched on email, in POST /account/export.
# Off by default: a shared address is a guess, not a proven match.
NODE_EXPORT_INCLUDE_FEEDBACK=false

# WARNING: owned by the webhooks module — delete it when removing the module (docs/modules/webhooks.md)
# Days. A delivery attempt row, not the subscription itself — TTL-retained like auditlogs/feedback.
#NODE_WEBHOOK_DELIVERY_RETENTION_DAYS=30

# Hours an Idempotency-Key record survives before Mongo's TTL index removes it. Long enough to
# outlast a client's retry backoff, short enough that it is never mistaken for a durable record
# of the write itself.
#NODE_IDEMPOTENCY_RETENTION_HOURS=24


# ============================================================
#  B7. Clustering & graceful shutdown
#  See: docs/theory/clustering.md
# ============================================================

NODE_ENABLE_CLUSTERING=1

# 0 = one worker per CPU core.
NODE_CLUSTER_WORKERS=0

NODE_CLUSTER_CRASH_WINDOW_MS=60000
NODE_CLUSTER_CRASH_BACKOFF_BASE_MS=500
NODE_CLUSTER_CRASH_BACKOFF_MAX_MS=30000
NODE_CLUSTER_SHUTDOWN_TIMEOUT_MS=15000
NODE_GRACEFUL_SHUTDOWN_TIMEOUT_MS=15000


# ============================================================
#  B8. Pagination
#  See: docs/theory/request-input.md
# ============================================================

# Used when the request omits pageSize.
#NODE_SETTINGS_PAGINATION_PAGE_SIZE=20


# ============================================================
#  B9. Anti-automation — rung 2, disposable-email refusal
# ============================================================

# off (default) | disposable (refuse a domain on the blocklist) | mx (also refuse a domain with
# no MX record). The blocklist itself ships as a dependency (disposable-email-domains-js), not a
# vendored file — see the two overrides below to tune it per deployment without a code change.
#NODE_ANTIBOT_EMAIL_POLICY=off

# Comma-separated extra domains to refuse beyond the shipped blocklist.
#NODE_ANTIBOT_EMAIL_DENYLIST_EXTRA=

# Comma-separated domains to exempt even if the blocklist would otherwise refuse them — a
# forwarding/aliasing service caught as a false positive, or a customer's own domain.
#NODE_ANTIBOT_EMAIL_ALLOWLIST=


# ============================================================
#  B10. Anti-automation — rung 4, human-challenge provider
# ============================================================

# none (default) | altcha | turnstile. `none` is a no-op that passes every caller — the demo and
# every test run through it. `altcha` is self-hosted proof-of-work: no vendor, no third-party
# script, at the cost of running the work on the visitor's device. `turnstile` is Cloudflare's,
# which puts their script in your pages and makes the data-protection question yours to answer.
# See docs/modules/antibot.md.
#NODE_ANTIBOT_PROVIDER=none

# altcha only, and required when it is selected — an unsigned challenge would let a caller mint
# itself a trivial one. Its own secret, so rotating a login secret leaves in-flight challenges
# alone.
#NODE_ANTIBOT_ALTCHA_SECRET=your-altcha-signing-secret-here

# PBKDF2 iterations a solver must work through. Higher taxes a bot's CPU and an honest visitor's
# alike — raise it only as far as the abuse justifies.
#NODE_ANTIBOT_ALTCHA_COST=100000

# Turnstile only, and both are required when it is selected. The site key is public and reaches
# the browser through GET /antibot/config; the secret never leaves the server.
# https://developers.cloudflare.com/turnstile/
#NODE_ANTIBOT_TURNSTILE_SITE_KEY=
#NODE_ANTIBOT_TURNSTILE_SECRET=


# ============================================================
#  B11. Breached-password checks
#  See: docs/theory/defences/authentication.md
# ============================================================

# Rung 1 — the bundled list (`src/infrastructure/security/breached-passwords/list.txt`), refreshed
# by hand with `npm run refresh:breached-passwords`. No network, on by default.
NODE_PASSWORD_BREACH_LIST=on

# Rung 2 — the HIBP k-anonymity range API. Off by default: this repo's convention is that anything
# reaching a third party is opt-in, and rung 1 alone protects a default install with no egress.
#NODE_PASSWORD_BREACH_HIBP=off

# Bounds the HIBP call so a slow lookup never becomes a slow signup. Fails open past this.
NODE_PASSWORD_BREACH_HIBP_TIMEOUT_MS=1500


# ============================================================
# ============================================================
#  PART C — OPTIONAL SUBSYSTEMS
# ============================================================
# ============================================================


# ============================================================
#  C1. Demo profile
#  See: docs/tools/demo-profile.md
# ============================================================

# Nothing to set here. `npm run demo` mounts the demo profile in-process
# (`enableDemoProfile()`) — no environment variable switches it on.

# Passwords for the seeded demo accounts — what you log in with by hand, and what the paired
# frontend's e2e suite authenticates with. Keep identical to its .env and its own copy in
# tests/support/e2e/accounts.ts; drift surfaces only as an e2e login failure.
NODE_SEED_ADMIN_PASSWORD=Demo-Admin1!
NODE_SEED_USER_PASSWORD=Demo-User1!
NODE_SEED_EDITOR_PASSWORD=Demo-Editor1!
NODE_SEED_MODERATOR_PASSWORD=Demo-Moderator1!


# ============================================================
#  C2. Message queue (RabbitMQ)
#  See: docs/tools/rabbitmq.md
# ============================================================
# Leave unset to disable queue operations entirely. The URI wins; otherwise the parts combine.

#NODE_RABBITMQ_URL=amqp://rabbitmq:5672
#NODE_RABBITMQ_HOST=rabbitmq
#NODE_RABBITMQ_PORT=5672
#NODE_RABBITMQ_USER=guest
#NODE_RABBITMQ_PASS=guest

# 0 disables the queue even when a URL is configured.
#NODE_RABBITMQ_ENABLED=1

# Deliveries a job gets before it is parked in <queue>.dead. A consumer that needs a different
# number declares it in code, next to its handler, rather than a second environment variable.
#NODE_QUEUE_MAX_ATTEMPTS=5

# How long a failed job waits in <queue>.retry before RabbitMQ redelivers it, in seconds.
#NODE_QUEUE_RETRY_DELAY_SECONDS=30


# ============================================================
#  C3. Payments
#  See: docs/modules/payments.md and docs/modules/payments-provider-port.md
# ============================================================

# Which implementation under src/modules/payments/providers answers. Only `fake` ships —
# magic method references, no outside calls. An unknown name refuses to resolve rather than
# falling back: a typo here must not mark orders paid that nobody was charged for.
#NODE_PAYMENT_PROVIDER=fake

# The secret POST /payments/webhook verifies deliveries against — an HMAC-SHA256 over
# `<unix seconds>.<raw body>`, sent as `x-payment-signature: t=…,v1=…`. With a live provider this
# is THEIR webhook signing secret, taken from their dashboard, and it is the only thing standing
# between an attacker and marking any order paid. Required in production — the app refuses to boot
# without it.
NODE_PAYMENT_WEBHOOK_SECRET=your-payment-webhook-secret-here

# ISO-4217, stamped on every payment document.
#NODE_DEFAULT_CURRENCY=EUR

# Bank transfer at checkout. Offered only when BOTH the beneficiary and the IBAN are set, and
# refused at boot when the IBAN (or the optional BIC) does not validate. The values below are
# fictional. See docs/modules/payments.md#bank-transfer.
NODE_BANK_TRANSFER_BENEFICIARY=Guebbit Demo Shop
NODE_BANK_TRANSFER_IBAN=IT60X0542811101000000123456
#NODE_BANK_TRANSFER_BIC=UNCRITMM
# How long a transfer order holds its stock. Days, not the card path's 30 minutes.
#NODE_BANK_TRANSFER_HOLD_HOURS=168
# How many transfer orders one account may leave awaiting payment at once.
#NODE_BANK_TRANSFER_MAX_OPEN_PER_ACCOUNT=2


# ============================================================
#  C4. Social login (OAuth)
# ============================================================
# A provider appears in GET /account/oauth/providers only once BOTH of its variables are set;
# placeholders are inert, and `npm run demo` enables a credential-free `fake` provider instead.
# Register the app at console.cloud.google.com/apis/credentials or github.com/settings/developers,
# with the callback URL NODE_URL + account/oauth/<name>/callback.

#NODE_OAUTH_GOOGLE_CLIENT_ID=
#NODE_OAUTH_GOOGLE_CLIENT_SECRET=
#NODE_OAUTH_GITHUB_CLIENT_ID=
#NODE_OAUTH_GITHUB_CLIENT_SECRET=

# Where that callback finally lands the browser — NOT NODE_CORS_ORIGIN, which validates XHR and
# is never a redirect target.
NODE_FRONTEND_URL=http://localhost:8080

# Path template each confirmation email fills in after NODE_FRONTEND_URL/<locale>/ — {token}/{id}
# are replaced per email, everything else matches the paired frontend's own routes.
#NODE_FRONTEND_LINK_VERIFY=verify-email/confirm?token={token}
#NODE_FRONTEND_LINK_RESET=password-reset/confirm?token={token}
#NODE_FRONTEND_LINK_DELETE=account-delete/confirm?token={token}
#NODE_FRONTEND_LINK_EMAIL_CHANGE=email-change/confirm?token={token}
#NODE_FRONTEND_LINK_ORDER=orders/{id}


# ============================================================
#  C5. Inventory
#  See: docs/modules/inventory-reservations.md
# ============================================================

# AVAILABLE units (on hand minus reserved) at or under this show as low stock.
#NODE_LOW_STOCK_THRESHOLD=5

# How long a checkout holds its units without payment. Nothing expires on its own —
# drive POST /inventory/reservations/sweep at least this often.
#NODE_RESERVATION_TTL_MINUTES=30


# ============================================================
#  C6. Product analytics
#  See: docs/tools/analytics.md
# ============================================================

# umami (default) | posthog | none. A name this build does not carry throws at boot
# rather than recording nothing quietly.
#NODE_ANALYTICS_PROVIDER=umami

# Gate events on caller consent. Setting false is a behaviour change.
# See: docs/tools/analytics.md#consent
NODE_ANALYTICS_REQUIRE_CONSENT=true

# ---------- provider: posthog ----------

# Both required, or events are discarded with a warning. The host is explicit because PostHog
# can be self-hosted or EU/US cloud, and a default would ship product data to the wrong region.
#NODE_POSTHOG_API_KEY=phc_your_project_api_key_here
#NODE_POSTHOG_HOST=https://app.posthog.com


# ============================================================
#  C7. Umami — all of it, in one place
#  See: docs/tools/analytics.md and docs/tools/frontend-observability.md
# ============================================================
# Three different hosts and two copies of one id, which is why they are gathered here rather
# than filed under whichever component reads each one:
#
#   NODE_UMAMI_HOST         public origin — the BROWSER loads the tracker script from it,
#                           and GET /observability/health reports it as integrations.umami
#   NODE_UMAMI_INGEST_HOST  internal address — the API dials it from inside the network
#   UMAMI_*                 the container itself (read by docker-compose, never by the API)
#
# The id must match on both sides. Under docker-compose both derive from UMAMI_WEBSITE_ID, so it
# matches by construction; running the API on the host, you set NODE_UMAMI_WEBSITE_ID yourself and
# a mismatch is a 404 on every event.

# ---------- read by the app ----------

#NODE_UMAMI_HOST=http://localhost:3080

# Unset, this falls back to NODE_UMAMI_HOST — which is wrong inside the network.
#NODE_UMAMI_INGEST_HOST=http://umami:3000

# Must match the id the frontend sends; an unknown id is rejected with a 404.
#NODE_UMAMI_WEBSITE_ID=00000000-0000-4000-8000-000000000001

# ---------- read by docker-compose ----------
# Unset gives a ready-to-use admin and website. A website id is normally random and copied out
# of the UI; the compose stack seeds a FIXED one so the frontend can hardcode it.

#UMAMI_PORT=3080

# Hashes session IDs.
#UMAMI_APP_SECRET=change-me-please

#UMAMI_ADMIN_USER=admin
#UMAMI_ADMIN_PASSWORD=umami

# Becomes the frontend's data-website-id, and NODE_UMAMI_WEBSITE_ID above.
#UMAMI_WEBSITE_ID=00000000-0000-4000-8000-000000000001
#UMAMI_WEBSITE_NAME=Frontend
#UMAMI_WEBSITE_DOMAIN=localhost

# Credentials for the Postgres container Umami stores its own data in.
#UMAMI_DB_NAME=umami
#UMAMI_DB_USER=umami
#UMAMI_DB_PASSWORD=umami


# ============================================================
#  C8. Observability
#  See: docs/tools/observability-reference.md
#       and docs/tools/frontend-observability.md for the browser half
# ============================================================

# MUST SET — bearer credential Prometheus scrapes /observability/metrics with. Boot refuses this
# placeholder. Must match docker/observability/prometheus.config.yaml.
# Unset (rather than placeholder) = the endpoint refuses every request.
NODE_METRICS_TOKEN=change-me-dev-metrics-token

# OTLP/HTTP endpoint of the OTel Collector. Unset disables trace export entirely.
# See: docs/tools/opentelemetry.md
#OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
#OTEL_EXPORTER_OTLP_HEADERS=Authorization=Bearer secret,X-Tenant=default

# ---------- reported by GET /observability/health ----------
# Declarative only: nothing here is dialled by the API, it reports these as integrations.loki /
# .faro. Unset, each reports false. NODE_UMAMI_HOST is the third of this shape — see C7 above.
# docker-compose sets all three, so they matter only when running the API on the host.

#NODE_LOKI_HOST=http://localhost:3100
#NODE_FARO_COLLECTOR_URL=http://localhost:12347/collect

# ---------- the browser half: Alloy ----------
# Alloy is the browser-facing collector for the frontend's Grafana Faro SDK — errors, logs,
# web-vitals, traces. Read by docker-compose, never by the API.

# Faro receiver: where the frontend posts its telemetry.
#ALLOY_FARO_PORT=12347
#ALLOY_UI_PORT=12345


# ============================================================
#  C9. PDF generation (Puppeteer)
#  See: docs/tools/email-and-rendering.md
# ============================================================

# Unset = /usr/bin/chromium-browser.
#PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser


# ============================================================
#  C10. Outbound webhooks
#  See: docs/modules/webhooks.md
# ============================================================

# WARNING: owned by the webhooks module — delete it when removing the module (docs/modules/webhooks.md)
# How many subscriptions ONE tenant may hold — the fan-out guard: one event x N subscriptions is
# N deliveries.
#NODE_WEBHOOK_SUBSCRIPTION_CAP=20

# WARNING: owned by the webhooks module — delete it when removing the module (docs/modules/webhooks.md)
# Base url of a local `webhook-tester` sink (compose --profile integrations). Unset (the default)
# seeds no demo subscription at all — see scenarios/webhooks.ts. Honoured only in development/test;
# set under production, the app refuses to boot. See docs/modules/webhooks.md#seeing-it-work for
# the seeded subscription's fixed, verifiable ring secret.
#NODE_WEBHOOK_DEMO_SINK_URL=http://webhook-tester:8080


# ============================================================
#  C11. Shop identity and VAT
#  See: docs/modules/products.md and docs/modules/orders.md
# ============================================================

# The shop's own jurisdiction — the ONLY rate basis this app ever uses. No destination lookup, no
# per-customer address: legal below the EU's €10,000 annual cross-border B2C threshold, which is
# where a boilerplate-sized shop sits. Required — the app refuses to boot without it. Also the
# invoice's own legal-identity line, and (eventually) the OSS registration country.
NODE_SHOP_COUNTRY=IT

# Printed on the invoice when set; omitted from it otherwise rather than blocking generation. A
# deployment not yet VAT-registered, or below the threshold, legitimately has none.
#NODE_SHOP_VAT_NUMBER=IT12345678901

# The invoice's supplier name. Distinct from any storefront brand name — this boilerplate does
# not otherwise configure one.
#NODE_SHOP_LEGAL_NAME=Guebbit Demo Shop Srl

# The two rates every product resolves to. Required, and boot refuses a value outside [0, 1) — a
# demo pair for Italy; a real deployment sets its own, from its accountant. NODE_VAT_RATE_DEFAULT
# applies to a product with no `taxClass`; NODE_VAT_RATE_REDUCED to one whose `taxClass` is
# `reduced` (books, food, medicine — depends on the jurisdiction). `taxClass: zero` needs neither —
# it is always 0%.
NODE_VAT_RATE_DEFAULT=0.22
NODE_VAT_RATE_REDUCED=0.10


# ============================================================
# ============================================================
#  PART D — NOT READ BY THE APP
# ============================================================
# ============================================================
# Nothing below reaches the running API. Setting one of these carefully to change the API's
# behaviour does nothing at all.


# ============================================================
#  D1. Read by docker-compose: the redis-server process
#  See: docs/tools/redis-cache.md
# ============================================================
# Keep the policy on an `allkeys-` variant, or Redis refuses writes at the ceiling instead of
# evicting.

#NODE_REDIS_MAXMEMORY=256mb
#NODE_REDIS_MAXMEMORY_POLICY=allkeys-lru


# ============================================================
#  D2. Read by docker-compose: log collection (Promtail)
#  See: docs/tools/docker-and-podman.md and docs/tools/loki.md
# ============================================================
# Promtail tails the host's container log files. Where they are and how they are framed is the
# only thing in this stack that differs between docker and podman. The defaults are docker's —
# on docker set none of the three; on podman set all three.
#
# CONTAINER_LOG_DRIVER is the one that is easy to miss: podman defaults to `journald`, which
# writes no log file at all, so Promtail matches nothing and Loki stays silently empty.

#CONTAINER_LOGS_PATH=/home/youruser/.local/share/containers/storage/overlay-containers
#PROMTAIL_CONFIG=promtail.podman.config.yaml
#CONTAINER_LOG_DRIVER=k8s-file

# NOT here: CONTAINER_ENGINE — npm never reads this file, so export it in your shell.
# NOT here: COMPOSE_FILE — podman-compose ignores it in `.env` and fails silently.


# ============================================================
#  D3. Read by npm scripts
#  See: docs/tools/pairing-and-ports.md
# ============================================================

# Where the paired frontend lives. Unset or empty falls back to ../boilerplate-vue-frontend.
FRONTEND_PATH=

# VitePress docs container. This repo owns 3000-3099, the paired frontend owns 8080-8099.
DOCS_PORT=3090

# WARNING: owned by the webhooks module — delete it when removing the module (docs/modules/webhooks.md)
# Webhook sink for outbound-webhook development. Only bound when the container runs, and it runs
# only under `compose --profile integrations up`.
WEBHOOK_TESTER_PORT=3070


# ============================================================
#  D4. Read by the test runners
#  See: docs/tools/testing-and-docs.md
# ============================================================
# How hard the suites may push THIS computer. A CLI flag beats any of them, so CI — which has
# no .env — keeps using the numbers its workflows pass.

# Stryker workers. The ceiling is RAM, not cores: a worker peaks at ~2.9 GB. Unset computes a
# default from THIS machine's free RAM and core count — see resolveConcurrency() in
# scripts/mutation/stryker-run.ts. Set it only to override that computation.
# See: docs/tools/mutation-testing.md
#STRYKER_CONCURRENCY=6

# Per-worker V8 heap cap, MB. Unset does NOT scale with this machine's RAM — V8 caps its default
# at ~4.2 GB, and a worker that wants more dies in the first minute at any concurrency. Budget this
# x STRYKER_CONCURRENCY against free RAM.
# See: docs/tools/mutation-testing.md#worker-heap-cap
#STRYKER_WORKER_HEAP_MB=

# Jest workers for a DIRECT run only — `npx jest --onlyChanged`, an IDE's gutter button, a single
# file. `npm run test:*` sizes itself instead through scripts/testing/machine-budget.ts, which
# reads this machine's free RAM (MemAvailable, not total) for its own computed default — but this,
# when SET, always wins over that computation; a SERIALIZED layer (integration/contract/fuzz)
# ignores it outright and runs one worker in band regardless.
# Unset, jest.config.js's own fallback is a fixed 2, not a computed default.
# See: docs/tools/weak-machines.md
#JEST_WORKERS=8

# Per-worker memory ceiling for that same direct-run fallback, MB. Reaches ONLY a bare jest run:
# `npm run test:*` passes `--workerIdleMemoryLimit` itself, and `test:unit:coverage` runs
# `--runInBand`, where the flag is inert either way.
#JEST_WORKER_MEMORY_MB=1400

# The spending limit for one `npm run test:*` shard process, MB — what actually decides how many
# sequential shards a SERIALIZED layer needs. Unset, computed from this machine's free RAM.
# See: docs/tools/weak-machines.md
#JEST_PROCESS_BUDGET_MB=2600

# How many sequential jest processes one SERIALIZED layer runs. Unset, computed from the budget
# above; on an otherwise-parallel layer (unit/cross-cutting) it forces sharding that would not
# otherwise happen.
#JEST_SHARDS=4

# The GENERATIVE suites' depth knobs: how many cases a property explores, how many participants a
# race fires. Turning one down trades rigour for time and memory — it changes what a suite ASKS,
# never what the code under test answers. Defaults / floors: TEST_PROPERTY_RUNS 300/10 (pure
# functions), TEST_PROPERTY_RUNS_DB 40/5 (hits a real database), TEST_FUZZ_RUNS 12/1 (spec-fuzz
# requests per operation), TEST_RACE_SIZE 10/2 (simultaneous in-flight requests) — it only goes
# down usefully, since the credential rate limiters are raised, not disabled, under test.
# See: docs/tools/property-testing.md, docs/tools/fuzz-testing.md, docs/tools/weak-machines.md
#TEST_PROPERTY_RUNS=300
#TEST_PROPERTY_RUNS_DB=40
#TEST_FUZZ_RUNS=12
#TEST_RACE_SIZE=10

# Where `npm run test:cluster` counts. Unset, the suite starts and stops its own Redis container.
# See: docs/tools/cluster-testing.md
#NODE_TEST_REDIS_URL=redis://127.0.0.1:6379

# The Mongo every suite (and `npm run demo`) connects to. Unset, each starts its own in-process
# `mongod` instead — see `src/infrastructure/runtime/ephemeral-mongo.ts`.
#NODE_TEST_MONGO_URI=mongodb://127.0.0.1:27017


# ============================================================
#  D5. Read by third-party libraries
# ============================================================

# Pre-installed mongod for mongodb-memory-server. Nothing sets this on a bare host — the library
# just downloads ~100 MB on first run and caches it. `docker/Dockerfile` bakes one at build time
# instead, via MONGOMS_DOWNLOAD_DIR. Point this at a binary you installed some other way; leave it
# UNSET (not a path that doesn't exist) otherwise — a mutation run carries this into
# Stryker's workers and a nonexistent path kills the dry run in seconds. See:
# docs/tools/testing-quickstart.md
#MONGOMS_SYSTEM_BINARY=


# ============================================================
#  D6. Read by docker-compose.production.yml — production stacks only
#  See: docs/getting-started-production.md
# ============================================================
# This whole file becomes `clients/<name>/.env`, so these ARE production secrets, one set per
# client — never copy one client's values to another.

# Starts the bundled MongoDB/Redis/RabbitMQ containers. Remove `bundled` (leave empty) when
# NODE_DB_URI/NODE_REDIS_URL/NODE_RABBITMQ_URL below point at a managed instance instead.
COMPOSE_PROFILES=bundled

# Image tag `app` builds and `cron`/`setup` reuse. Change it to run a pinned older tag during a
# staged rollout.
#APP_IMAGE=boilerplate-api:latest

# ~200 MB of Chromium for the PDF invoice endpoint. See docker/Dockerfile.production.
#INSTALL_CHROMIUM=false

# The bundled MongoDB's root and app-user credentials — maintenance-only root, the app connects as
# the app user. Both MUST SET when COMPOSE_PROFILES includes `bundled`.
MONGO_ROOT_PASSWORD=change-me
#MONGO_ROOT_USER=root
MONGO_APP_PASSWORD=change-me
#MONGO_APP_USER=api
#MONGO_DB=api

# The bundled Redis and RabbitMQ credentials. MUST SET when COMPOSE_PROFILES includes `bundled`.
REDIS_PASSWORD=change-me
RABBITMQ_PASSWORD=change-me
#RABBITMQ_USER=guest

# Only read by docker-compose.proxy.yml — the Traefik overlay for many client stacks sharing one
# host. Unused, and safe to leave unset, on a single-stack deployment behind its own proxy.
#NODE_PROXY_DOMAIN=acme.example.com
#NODE_PROXY_ACME_EMAIL=ops@example.com
