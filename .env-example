# ============================================================
#  Boilerplate Node Backend — environment configuration
# ============================================================
# Copy to `.env` and adjust.
#
# Conventions:
#   - every comment sits ABOVE the variable it explains
#   - `#VAR=` means optional; the value shown is the default
#   - `MUST SET` means the app refuses to boot, or starts and is wrong
#   - a variable whose name already says it carries no comment
#   - the app reads every variable unless its section says who else does
#   - each section links the page that explains it in full
#
# Four parts, in the order you need them:
#   A. must set          — nothing runs, or nothing is correct, until these are right
#   B. review before deploying  — sane defaults, wrong ones for a real deployment
#   C. optional subsystems      — off unless configured
#   D. not read by the app      — docker-compose, npm scripts, third-party libraries
# ============================================================


# ============================================================
# ============================================================
#  PART A — MUST SET
# ============================================================
# ============================================================


# ============================================================
#  A1. Core runtime
# ============================================================

NODE_ENV=development

# Port app.listen binds.
NODE_PORT=3000

# MUST SET — base URL for every outgoing link: password-reset emails, account-deletion
# confirmations, OAuth callbacks. Boot refuses an empty value, because a wrong one is a broken
# link in someone's inbox and nothing logs it.
NODE_URL=http://localhost:3000/

# MUST SET in production — origins allowed to call this API, comma-separated. The code default is
# http://localhost:8080, which is right for a developer and never right for a deployment, so boot
# refuses an empty value when NODE_ENV=production.
NODE_CORS_ORIGIN=http://localhost:8080,http://localhost:8085,http://localhost:3000

# Directory served as static files.
NODE_PUBLIC_PATH=public

# Max JSON/urlencoded request body.
NODE_JSON_BODY_LIMIT=100kb


# ============================================================
#  A2. Database (MongoDB)
#  See: docs/tools/mongodb-mongoose.md
# ============================================================

# A full URI wins outright. Blanking it is how `npm run host` falls through to the components
# below and reaches a containerised database while keeping the database name from this file.
NODE_DB_URI=mongodb://database:27017/boilerplate-node-backend

NODE_MONGODB_HOST=database
NODE_MONGODB_PORT=27017
NODE_MONGODB_NAME=boilerplate-node-backend


# ============================================================
#  A3. Cache (Redis)
#  See: docs/tools/redis-cache.md
# ============================================================

# Same precedence as the database above: the URI wins, the parts are the `npm run host` path.
NODE_REDIS_URL=redis://redis:6379
NODE_REDIS_HOST=redis
NODE_REDIS_PORT=6379

# 0 serves every request uncached.
NODE_REDIS_CACHE_ENABLED=1

NODE_REDIS_CACHE_PREFIX=boilerplate-node-backend

# Longest cache TTL allowed outside production, in seconds. 0 disables the cap.
#NODE_REDIS_CACHE_DEV_TTL_MAX=30

# Largest response body the cache will store, in bytes. A larger one is still served, just not cached.
#NODE_REDIS_CACHE_MAX_BYTES=262144


# ============================================================
#  A4. Authentication & tokens
#  See: docs/tools/security.md and docs/modules/account-sessions.md
# ============================================================

# MUST SET — boot refuses this placeholder.
NODE_TOKEN_ACCESS=your-access-token-secret-here

# MUST SET — boot refuses this placeholder.
NODE_TOKEN_REFRESH=your-refresh-token-secret-here

# MUST SET — encrypts device secrets and keys the HMAC of delivered codes. Boot refuses this
# placeholder: a secret encrypted under it is readable by anyone who has this repository.
# See: docs/tools/security.md#two-factor-authentication
NODE_TOTP_ENCRYPTION_KEY=your-totp-encryption-key-here

# Seconds. Unset uses the default shown — never zero, which would expire a token as it is signed.
#NODE_TOKEN_ACCESS_TIME=600

# Seconds, one per "remember me" tier: 7 days, 30 days, a year.
#NODE_TOKEN_REFRESH_TIME_SHORT=604800
#NODE_TOKEN_REFRESH_TIME_MEDIUM=2592000
#NODE_TOKEN_REFRESH_TIME_LONG=31536000

# How long a rotated refresh token is still honoured, ms — absorbs two tabs refreshing at once.
NODE_TOKEN_ROTATION_GRACE_MS=10000

# Step-up windows, seconds: how recently a caller must have proved themselves.
# Critical covers money and destruction; sensitive covers identity and sessions.
NODE_REAUTH_TIME_CRITICAL=300
NODE_REAUTH_TIME_SENSITIVE=900

# Code guesses allowed against one login challenge.
NODE_MFA_CHALLENGE_MAX=5

# Codes delivered per challenge — a first send plus two resends.
NODE_MFA_SEND_MAX=3


# ============================================================
# ============================================================
#  PART B — REVIEW BEFORE DEPLOYING
# ============================================================
# ============================================================


# ============================================================
#  B1. Rate limiting
#  See: docs/tools/security.md#the-rate-limit-budgets
# ============================================================

# Reverse proxies in front of the API. Too low buckets every caller together;
# too high lets a caller forge X-Forwarded-For. See: docs/tools/security.md#trust-proxy-and-the-two-ways-to-get-it-wrong
NODE_TRUST_PROXY_HOPS=0

# The global burst brake: window in ms, then requests per address inside it.
NODE_RATE_LIMIT_WINDOW_MS=60000
NODE_RATE_LIMIT_MAX=100

# FAILED credential attempts per window — two independent buckets, per account and per address.
# Only failures count.
NODE_AUTH_RATE_LIMIT_MAX=10
NODE_AUTH_RATE_LIMIT_ADDRESS_MAX=30

# Contact-form posts per address per window. Spent by SUCCESS, since abuse also gets a 201.
NODE_SUBMISSION_RATE_LIMIT_MAX=5

# Image uploads per address per window. Spent by success, same reasoning.
NODE_UPLOAD_RATE_LIMIT_MAX=20

# Raise the two above to ~1000 when serving the frontend's `test:e2e:live`, never in a deployment.

# Where the limiters COUNT. 0 counts in memory — with no Redis the counters are per process,
# which multiplies every budget above by the worker count. The app logs an error when that happens.
NODE_RATE_LIMIT_REDIS_ENABLED=1

# Unset falls back to NODE_REDIS_URL, then NODE_REDIS_HOST + NODE_REDIS_PORT.
NODE_RATE_LIMIT_REDIS_URL=
NODE_RATE_LIMIT_REDIS_PREFIX=rate-limit


# ============================================================
#  B2. Localisation
#  See: docs/tools/i18n.md
# ============================================================

# The language used outside a request — jobs, workers, boot.
NODE_DEFAULT_LOCALE=en

# The language used when Accept-Language matches nothing supported.
NODE_FALLBACK_LOCALE=en

# Unset = every src/locales/*.json.
#NODE_SUPPORTED_LOCALES=en,it

# A tenant is one audience's set of admin-edited translation overrides, layered over the
# deployed files. The backend's own are never served to clients; the frontend's are what
# GET /locales/{locale}/messages builds when the client names no tenant of its own.
# EXTRA takes comma-separated `id=Label` pairs and is listed by GET /locales/tenants.
#NODE_LOCALE_TENANT_BACKEND=demo-be
#NODE_LOCALE_TENANT_FRONTEND=demo-fe
#NODE_LOCALE_TENANTS_EXTRA=

# How often a worker re-reads those overrides, ms — bounds how long the others may still
# answer with the previous text.
#NODE_LOCALE_OVERRIDE_REFRESH_MS=60000


# ============================================================
#  B3. Uploads & images
#  See: docs/tools/image-processing.md
# ============================================================

# multer's own default is unlimited.
NODE_MAX_UPLOAD_BYTES=5242880

# Where an upload waits while the request is checked. NOT inside NODE_PUBLIC_PATH.
# Unset = <system temp>/node-api-uploads.
#NODE_UPLOAD_STAGING_PATH=/var/tmp/node-api-uploads

# Where un-sanitised bytes sit until the digest pipeline clears them. Resolved against the
# WORKING DIRECTORY when relative, so it lands wherever the process was launched from.
#NODE_QUARANTINE_PATH=quarantine

# Served while a digest is still running, so a record has an image between upload and promotion.
#NODE_PENDING_IMAGE_URL=/images/system/pending.png
#NODE_PENDING_THUMBNAIL_URL=/images/system/pending-thumb.webp

# Used when a record carries no image of its own.
NODE_DEFAULT_IMAGE_PRODUCT=https://placekitten.com/400/400
NODE_DEFAULT_IMAGE_USER=https://placekitten.com/600/600


# ============================================================
#  B4. Email (SMTP)
#  See: docs/tools/email-and-rendering.md
# ============================================================
# Optional as a whole — unset, the email second factor reports itself unavailable. But
# ALL OR NOTHING: boot refuses a NODE_SMTP_HOST set without USER, PASS and SENDER, because a
# half-configured transport only fails when a real user asks to reset a password.

NODE_SMTP_HOST=mail.guebbit.com
NODE_SMTP_PORT=465
NODE_SMTP_USER=noreply@guebbit.com
NODE_SMTP_PASS=emailpassword

# From-header, `Display Name <address>`. Its display half is also the TOTP issuer, so changing it
# renames the entry in every user's authenticator app.
NODE_SMTP_SENDER="Guebbit <noreply@guebbit.com>"

# Hostname this client announces in the SMTP EHLO greeting. Some strict servers check it.
NODE_SMTP_NAME=hostgator

# Recipient of contact / feedback notifications. Unset falls back to NODE_SMTP_SENDER.
NODE_CONTACT_NOTIFY_EMAIL=admin@guebbit.com

# Unset = the EJS templates shipped with the app.
#NODE_EMAIL_TEMPLATES_DIR=/srv/email-templates


# ============================================================
#  B5. Logging
#  See: docs/tools/winston.md
# ============================================================

# error | warn | info | http | verbose | debug | silly.
# Unset = info in production, debug elsewhere.
NODE_LOG_LEVEL=debug

# Tags every log entry — tells services apart in a shared aggregator.
NODE_SERVICE_NAME=api

# How email, ip, phone, street, zip and fullName are treated: hash | redact | plain.
NODE_LOG_PERSONAL_FIELDS=hash


# ============================================================
#  B6. Data retention & privacy
#  See: docs/theory/data-protection.md and docs/reference/ops.md
# ============================================================
# Each backs a Mongo TTL index. Changing one on an existing database needs a migration
# (collMod): Mongo will not alter an already-created TTL index.

# Days. Affects only the queryable copy behind GET /observability/audit —
# the audit log FILE is the compliance record and is untouched.
NODE_AUDIT_RETENTION_DAYS=90

# Days. 24 months sits inside the common limitation periods for a commercial dispute.
NODE_FEEDBACK_RETENTION_DAYS=730

# Days an abandoned cart survives.
NODE_CART_RETENTION_DAYS=365

# Days of no login before `npm run reap:inactive-accounts` warns, soft-deletes, then
# hard-deletes an account. 0 disables it.
NODE_INACTIVE_ACCOUNT_DAYS=0

# Days after account erasure before `npm run reap:orders` scrubs an order's remaining PII.
# The row itself is never deleted.
NODE_ORDER_PII_RETENTION_DAYS=3650

# Include the caller's feedback tickets, matched on email, in POST /account/export.
# Off by default: a shared address is a guess, not a proven match.
NODE_EXPORT_INCLUDE_FEEDBACK=false


# ============================================================
#  B7. Clustering & graceful shutdown
#  See: docs/theory/clustering.md
# ============================================================

NODE_ENABLE_CLUSTERING=1

# 0 = one worker per CPU core.
NODE_CLUSTER_WORKERS=0

NODE_CLUSTER_CRASH_WINDOW_MS=60000
NODE_CLUSTER_CRASH_BACKOFF_BASE_MS=500
NODE_CLUSTER_CRASH_BACKOFF_MAX_MS=30000
NODE_CLUSTER_SHUTDOWN_TIMEOUT_MS=15000
NODE_GRACEFUL_SHUTDOWN_TIMEOUT_MS=15000


# ============================================================
#  B8. Pagination
#  See: docs/theory/request-input.md
# ============================================================

# Used when the request omits pageSize.
#NODE_SETTINGS_PAGINATION_PAGE_SIZE=20


# ============================================================
# ============================================================
#  PART C — OPTIONAL SUBSYSTEMS
# ============================================================
# ============================================================


# ============================================================
#  C1. Demo profile
#  See: docs/tools/demo-profile.md
# ============================================================

# Mounts /demo and captures outgoing email instead of sending it. Also skips the boot-time
# config gate, so a demo starts off a copied .env-example with its placeholders intact.
#NODE_DEMO=false

# Passwords for the seeded demo accounts — what you log in with by hand, and what the paired
# frontend's e2e suite authenticates with. Keep identical to its .env and its own copy in
# tests/support/e2e/accounts.ts; drift surfaces only as an e2e login failure.
NODE_SEED_ADMIN_PASSWORD=Demo-Admin1!
NODE_SEED_USER_PASSWORD=Demo-User1!


# ============================================================
#  C2. Message queue (RabbitMQ)
#  See: docs/tools/rabbitmq.md
# ============================================================
# Leave unset to disable queue operations entirely. The URI wins; otherwise the parts combine.

#NODE_RABBITMQ_URL=amqp://rabbitmq:5672
#NODE_RABBITMQ_HOST=rabbitmq
#NODE_RABBITMQ_PORT=5672
#NODE_RABBITMQ_USER=guest
#NODE_RABBITMQ_PASS=guest

# 0 disables the queue even when a URL is configured.
#NODE_RABBITMQ_ENABLED=1


# ============================================================
#  C3. Payments
#  See: docs/modules/payments.md and docs/modules/payments-provider-port.md
# ============================================================

# Which implementation under src/modules/payments/providers answers. Only `fake` ships —
# magic test cards, no outside calls.
#NODE_PAYMENT_PROVIDER=fake

# ISO-4217, stamped on every payment document.
#NODE_DEFAULT_CURRENCY=EUR


# ============================================================
#  C4. Social login (OAuth)
# ============================================================
# A provider appears in GET /account/oauth/providers only once BOTH of its variables are set;
# placeholders are inert, and `npm run demo` enables a credential-free `fake` provider instead.
# Register the app at console.cloud.google.com/apis/credentials or github.com/settings/developers,
# with the callback URL NODE_URL + account/oauth/<name>/callback.

#NODE_OAUTH_GOOGLE_CLIENT_ID=
#NODE_OAUTH_GOOGLE_CLIENT_SECRET=
#NODE_OAUTH_GITHUB_CLIENT_ID=
#NODE_OAUTH_GITHUB_CLIENT_SECRET=

# Where that callback finally lands the browser — NOT NODE_CORS_ORIGIN, which validates XHR and
# is never a redirect target.
NODE_FRONTEND_URL=http://localhost:8080


# ============================================================
#  C5. Inventory
#  See: docs/modules/inventory-reservations.md
# ============================================================

# AVAILABLE units (on hand minus reserved) at or under this show as low stock.
#NODE_LOW_STOCK_THRESHOLD=5

# How long a checkout holds its units without payment. Nothing expires on its own —
# drive POST /inventory/reservations/sweep at least this often.
#NODE_RESERVATION_TTL_MINUTES=30


# ============================================================
#  C6. Product analytics
#  See: docs/tools/analytics.md
# ============================================================

# umami (default) | posthog | none. A name this build does not carry throws at boot
# rather than recording nothing quietly.
#NODE_ANALYTICS_PROVIDER=umami

# Gate events on caller consent. Setting false is a behaviour change.
# See: docs/tools/analytics.md#consent
NODE_ANALYTICS_REQUIRE_CONSENT=true

# ---------- provider: posthog ----------

# Both required, or events are discarded with a warning. The host is explicit because PostHog
# can be self-hosted or EU/US cloud, and a default would ship product data to the wrong region.
#NODE_POSTHOG_API_KEY=phc_your_project_api_key_here
#NODE_POSTHOG_HOST=https://app.posthog.com


# ============================================================
#  C7. Umami — all of it, in one place
#  See: docs/tools/analytics.md and docs/tools/frontend-observability.md
# ============================================================
# Three different hosts and two copies of one id, which is why they are gathered here rather
# than filed under whichever component reads each one:
#
#   NODE_UMAMI_HOST         public origin — the BROWSER loads the tracker script from it,
#                           and GET /observability/health reports it as integrations.umami
#   NODE_UMAMI_INGEST_HOST  internal address — the API dials it from inside the network
#   UMAMI_*                 the container itself (read by docker-compose, never by the API)
#
# The id must match on both sides. Under docker-compose both derive from UMAMI_WEBSITE_ID, so it
# matches by construction; running the API on the host, you set NODE_UMAMI_WEBSITE_ID yourself and
# a mismatch is a 404 on every event.

# ---------- read by the app ----------

#NODE_UMAMI_HOST=http://localhost:3080

# Unset, this falls back to NODE_UMAMI_HOST — which is wrong inside the network.
#NODE_UMAMI_INGEST_HOST=http://umami:3000

# Must match the id the frontend sends; an unknown id is rejected with a 404.
#NODE_UMAMI_WEBSITE_ID=00000000-0000-4000-8000-000000000001

# ---------- read by docker-compose ----------
# Unset gives a ready-to-use admin and website. A website id is normally random and copied out
# of the UI; the compose stack seeds a FIXED one so the frontend can hardcode it.

#UMAMI_PORT=3080

# Hashes session IDs.
#UMAMI_APP_SECRET=change-me-please

#UMAMI_ADMIN_USER=admin
#UMAMI_ADMIN_PASSWORD=umami

# Becomes the frontend's data-website-id, and NODE_UMAMI_WEBSITE_ID above.
#UMAMI_WEBSITE_ID=00000000-0000-4000-8000-000000000001
#UMAMI_WEBSITE_NAME=Frontend
#UMAMI_WEBSITE_DOMAIN=localhost

# Credentials for the Postgres container Umami stores its own data in.
#UMAMI_DB_NAME=umami
#UMAMI_DB_USER=umami
#UMAMI_DB_PASSWORD=umami


# ============================================================
#  C8. Observability
#  See: docs/tools/observability-reference.md
#       and docs/tools/frontend-observability.md for the browser half
# ============================================================

# MUST SET — bearer credential Prometheus scrapes /observability/metrics with. Boot refuses this
# placeholder. Must match .docker/observability/prometheus.config.yaml.
# Unset (rather than placeholder) = the endpoint refuses every request.
NODE_METRICS_TOKEN=change-me-dev-metrics-token

# OTLP/HTTP endpoint of the OTel Collector. Unset disables trace export entirely.
# See: docs/tools/opentelemetry.md
#OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
#OTEL_EXPORTER_OTLP_HEADERS=Authorization=Bearer secret,X-Tenant=default

# ---------- reported by GET /observability/health ----------
# Declarative only: nothing here is dialled by the API, it reports these as integrations.loki /
# .faro. Unset, each reports false. NODE_UMAMI_HOST is the third of this shape — see C7 above.
# docker-compose sets all three, so they matter only when running the API on the host.

#NODE_LOKI_HOST=http://localhost:3100
#NODE_FARO_COLLECTOR_URL=http://localhost:12347/collect

# ---------- the browser half: Alloy ----------
# Alloy is the browser-facing collector for the frontend's Grafana Faro SDK — errors, logs,
# web-vitals, traces. Read by docker-compose, never by the API.

# Faro receiver: where the frontend posts its telemetry.
#ALLOY_FARO_PORT=12347
#ALLOY_UI_PORT=12345


# ============================================================
#  C9. PDF generation (Puppeteer)
#  See: docs/tools/email-and-rendering.md
# ============================================================

# Unset = /usr/bin/chromium-browser.
#PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser


# ============================================================
# ============================================================
#  PART D — NOT READ BY THE APP
# ============================================================
# ============================================================
# Nothing below reaches the running API. Setting one of these carefully to change the API's
# behaviour does nothing at all.


# ============================================================
#  D1. Read by docker-compose: the redis-server process
#  See: docs/tools/redis-cache.md
# ============================================================
# Keep the policy on an `allkeys-` variant, or Redis refuses writes at the ceiling instead of
# evicting.

#NODE_REDIS_MAXMEMORY=256mb
#NODE_REDIS_MAXMEMORY_POLICY=allkeys-lru


# ============================================================
#  D2. Read by docker-compose: log collection (Promtail)
#  See: docs/tools/docker-and-podman.md and docs/tools/loki.md
# ============================================================
# Promtail tails the host's container log files. Where they are and how they are framed is the
# only thing in this stack that differs between docker and podman. The defaults are docker's —
# on docker set none of the three; on podman set all three.
#
# CONTAINER_LOG_DRIVER is the one that is easy to miss: podman defaults to `journald`, which
# writes no log file at all, so Promtail matches nothing and Loki stays silently empty.

#CONTAINER_LOGS_PATH=/home/youruser/.local/share/containers/storage/overlay-containers
#PROMTAIL_CONFIG=promtail.podman.config.yaml
#CONTAINER_LOG_DRIVER=k8s-file

# NOT here: CONTAINER_ENGINE — npm never reads this file, so export it in your shell.
# NOT here: COMPOSE_FILE — podman-compose ignores it in `.env` and fails silently.


# ============================================================
#  D3. Read by npm scripts
#  See: docs/tools/pairing-and-ports.md
# ============================================================

# Where the paired frontend lives. Unset or empty falls back to ../boilerplate-vue-frontend.
FRONTEND_PATH=

# VitePress docs container. This repo owns 3000-3099, the paired frontend owns 8080-8099.
DOCS_PORT=3090


# ============================================================
#  D4. Read by the test runners
#  See: docs/tools/testing-and-docs.md
# ============================================================
# How hard the suites may push THIS computer. A CLI flag beats any of them, so CI — which has
# no .env — keeps using the numbers its workflows pass.

# Stryker workers. The ceiling is RAM, not cores: a worker peaks at ~2.9 GB.
# See: docs/tools/mutation-testing.md
STRYKER_CONCURRENCY=6

# Per-worker V8 heap cap, MB. LEAVE UNSET: it bounds V8's old space only, while the memory a run
# accumulates sits outside it. `maxTestRunnerReuse` is what actually bounds this.
#STRYKER_WORKER_HEAP_MB=

# Jest workers. Unset falls back to `logical CPUs - 2`. Set it on a many-core machine:
# jest's own default counts cores for a workload bounded by memory, and gets OOM-killed.
# See: docs/tools/unit-testing.md
JEST_WORKERS=8

# Where `npm run test:cluster` counts. Unset, the suite starts and stops its own Redis container.
# See: docs/tools/cluster-testing.md
#NODE_TEST_REDIS_URL=redis://127.0.0.1:6379


# ============================================================
#  D5. Read by third-party libraries
# ============================================================

# Pre-installed mongod for mongodb-memory-server, from `npm run setup:mongod`.
# Absent, the library downloads ~100 MB on first run. See: docs/tools/unit-testing.md
MONGOMS_SYSTEM_BINARY=/tmp/mongod
