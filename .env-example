# ============================================================
#  Boilerplate Node Backend — Environment Configuration
# ============================================================
# Copy this file to `.env` and adjust the values for your
# environment. Commented lines (`#`) are optional.
# ============================================================


# ============================================================
#  Core
# ============================================================

NODE_ENV=development
NODE_PUBLIC_PATH=public                           # static file storage directory
NODE_URL=http://localhost:3000/                   # base URL for outgoing links (e.g. email password-reset links)
NODE_PORT=3000                                    # API HTTP port (used by app.listen)
NODE_CORS_ORIGIN=http://localhost:8080,http://localhost:8085,http://localhost:3000  # CORS allowed origins (comma-separated). 8080 = frontend dev server, 8085 = frontend e2e server (test:e2e / test:e2e:live), 3000 = this API.


# ============================================================
#  Database
# ============================================================

# MongoDB — preferred explicit URI; if omitted, HOST / PORT / NAME fallback is used
NODE_DB_URI=mongodb://database:27017/boilerplate-node-backend

# Fallback individual components (used when NODE_DB_URI is not set)
NODE_MONGODB_HOST=database
NODE_MONGODB_PORT=27017
NODE_MONGODB_NAME=boilerplate-node-backend


# ============================================================
#  Redis Cache
# ============================================================

NODE_REDIS_URL=redis://redis:6379
NODE_REDIS_HOST=redis
NODE_REDIS_PORT=6379
NODE_REDIS_CACHE_ENABLED=1
NODE_REDIS_CACHE_PREFIX=boilerplate-node-backend

# Longest cache TTL allowed when NODE_ENV is not "production", in seconds.
# Routes declare their own TTL (e.g. setCache(3600) on GET /products); outside production it is
# clamped to this. Why: the cache is only invalidated by writes that go THROUGH the API, so a
# db:seed / migration / mongosh edit leaves stale answers until they expire on their own.
# A low ceiling bounds that to seconds instead of an hour. Set to 0 to disable the cap.
#NODE_REDIS_CACHE_DEV_TTL_MAX=30

# Largest response body the cache will store, in bytes. Default 262144 (256 KB).
# Why: caching turns a cheap request into long-lived server state. GET /products is public, its
# entries live for an hour, and the key carries the full URL — so an unauthenticated caller can
# mint a distinct entry per query string. Bounding the entry keeps that from being an amplifier.
# A response above the limit is still returned normally, it just is not cached.
#NODE_REDIS_CACHE_MAX_BYTES=262144

# How much memory the Redis container may use, and what it does when it gets there.
# Read by docker-compose.yml, not by the app: they configure the redis-server process itself.
# Redis defaults to unlimited memory, which is the wrong default for a cache — entry count here
# follows traffic (GET /products is public and its answers live for an hour), not data size.
# Keep the policy on an `allkeys-` variant: at the ceiling Redis then evicts the least useful key
# and accepts the write, where the `noeviction` default would start refusing writes instead.
#NODE_REDIS_MAXMEMORY=256mb
#NODE_REDIS_MAXMEMORY_POLICY=allkeys-lru


# ============================================================
#  Security & Tokens
# ============================================================

NODE_DEFAULT_LOCALE=en                             # Language used outside a request (jobs, workers, boot)
NODE_FALLBACK_LOCALE=en                            # Used when Accept-Language matches nothing supported
# NODE_SUPPORTED_LOCALES=en,it                     # Optional override; unset = every src/locales/*.json
NODE_METRICS_TOKEN=change-me-dev-metrics-token     # Bearer credential Prometheus scrapes /observability/metrics with.
                                                   # Must match .docker/observability/prometheus.config.yaml.
                                                   # Unset = the endpoint refuses every request (503).
NODE_TRUST_PROXY_HOPS=0                            # Number of reverse proxies in front of the API. Must match reality:
                                                   #   too low  = the rate limiter buckets every caller together
                                                   #   too high = a caller forges X-Forwarded-For and bypasses it
NODE_AUTH_RATE_LIMIT_MAX=10                        # Credential attempts per IP per window (login, signup, reset)
                                                   # Raise BOTH limits to ~1000 when booting this API for the
                                                   # paired frontend's `test:e2e:live`: 85 specs from one IP blow
                                                   # through a browsing-sized budget, and the resulting 429 shows
                                                   # up as "login is broken". Never raise them in a deployment.
NODE_MAX_UPLOAD_BYTES=5242880                      # 5 MB per file; multer's own default is UNLIMITED
# NODE_UPLOAD_STAGING_PATH=/var/tmp/node-api-uploads # Where an upload waits while the request is checked.
                                                   # NOT inside NODE_PUBLIC_PATH: nothing is publicly readable
                                                   # until it has passed every check. Unset = <system temp>/node-api-uploads.
NODE_DEFAULT_IMAGE_PRODUCT=https://placekitten.com/400/400
NODE_DEFAULT_IMAGE_USER=https://placekitten.com/600/600
NODE_RATE_LIMIT_WINDOW_MS=60000                    # 1 minute — a burst brake, not a quota
NODE_RATE_LIMIT_MAX=100                            # Requests per IP per window; test suites use 10x

# Access token — short-lived (value is in seconds; 600 = 10 minutes)
NODE_TOKEN_ACCESS=your-access-token-secret-here
NODE_TOKEN_ACCESS_TIME=600

# Refresh token — long-lived (seconds)
NODE_TOKEN_REFRESH=your-refresh-token-secret-here
NODE_TOKEN_REFRESH_TIME_SHORT=604800     # 7 days
NODE_TOKEN_REFRESH_TIME_MEDIUM=2592000   # 30 days
NODE_TOKEN_REFRESH_TIME_LONG=31536000    # 1 year

# Token cleanup is performed on-demand during refresh token operations.


# ============================================================
#  Clustering & Graceful Shutdown
# ============================================================

NODE_ENABLE_CLUSTERING=1
NODE_CLUSTER_WORKERS=0                            # 0 = auto (number of CPU cores)
NODE_CLUSTER_CRASH_WINDOW_MS=60000
NODE_CLUSTER_CRASH_BACKOFF_BASE_MS=500
NODE_CLUSTER_CRASH_BACKOFF_MAX_MS=30000
NODE_CLUSTER_SHUTDOWN_TIMEOUT_MS=15000
NODE_GRACEFUL_SHUTDOWN_TIMEOUT_MS=15000


# ============================================================
#  Pagination
# ============================================================

# Default page size (used when the request omits pageSize)
#NODE_SETTINGS_PAGINATION_PAGE_SIZE=20


# ============================================================
#  Email (Nodemailer SMTP)
# ============================================================

NODE_SMTP_NAME=hostgator
NODE_SMTP_HOST=mail.guebbit.com
NODE_SMTP_PORT=465
NODE_SMTP_USER=noreply@guebbit.com
NODE_SMTP_SENDER="Guebbit <noreply@guebbit.com>"
NODE_SMTP_PASS=emailpassword

# Emails that will receive contact / feedback notifications
NODE_CONTACT_NOTIFY_EMAIL=admin@guebbit.com


# ============================================================
#  Logging
# ============================================================

# Log verbosity level.
# Values: error | warn | info | http | verbose | debug | silly
# Default: 'info' in production, 'debug' in all other environments.
NODE_LOG_LEVEL=debug

# Service name tag written into every log entry.
# Useful when multiple services ship logs to the same aggregator (Loki, etc.).
NODE_SERVICE_NAME=api

# How long persisted audit entries survive, in days, before Mongo's TTL index removes them.
# Only affects the queryable copy behind GET /observability/audit — the audit *log file* is the
# compliance record and is not touched by this.
# Changing it on an existing database needs a migration (collMod): Mongo will not alter an
# already-created TTL index. Default: 90.
NODE_AUDIT_RETENTION_DAYS=90

# Loki origin. Logs are shipped by Promtail, not by the app, so this is purely
# declarative: GET /observability/health reports integrations.loki from it.
# Leave unset and the health endpoint reports loki as false.
#NODE_LOKI_HOST=http://localhost:3100


# ============================================================
#  RabbitMQ Message Queue  (optional)
# ============================================================
# Leave unset to disable queue operations entirely.
# Full AMQP URI is preferred; if omitted, HOST / PORT / USER / PASS are combined.

#NODE_RABBITMQ_URL=amqp://rabbitmq:5672
#NODE_RABBITMQ_HOST=rabbitmq
#NODE_RABBITMQ_PORT=5672
#NODE_RABBITMQ_USER=guest
#NODE_RABBITMQ_PASS=guest
#NODE_RABBITMQ_ENABLED=1                          # set to 0 to disable even when URL is configured


# ============================================================
#  Payments  (optional)
# ============================================================
# Which payment provider implementation answers (src/modules/payments/providers).
# The boilerplate ships only `fake` — magic test cards, no outside calls — and defaults to it.
# A real integration is one more implementation beside it and this one env var.

#NODE_PAYMENT_PROVIDER=fake
#NODE_DEFAULT_CURRENCY=EUR                        # ISO-4217; stamped on every payment document


# ============================================================
#  Inventory  (optional)
# ============================================================
# Shelf counts at or under this show up in the low-stock gauge and the admin overview.

#NODE_LOW_STOCK_THRESHOLD=5


# ============================================================
#  OpenTelemetry Tracing  (optional)
# ============================================================
# OTLP/HTTP endpoint of the OTel Collector (fans out to Tempo, etc.).
# Leave unset to disable trace export entirely.
# docker-compose sets this to http://otel-collector:4318

#OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
#OTEL_EXPORTER_OTLP_HEADERS=Authorization=Bearer secret,X-Tenant=default


# ============================================================
#  PostHog Product Analytics  (optional)
# ============================================================
# Leave unset to disable all analytics emission.

#NODE_POSTHOG_API_KEY=phc_your_project_api_key_here
#NODE_POSTHOG_HOST=https://app.posthog.com


# ============================================================
#  Frontend Observability  (self-hosted, for the paired frontend)
# ============================================================
# Alloy = browser-facing collector for the Grafana Faro Web SDK (errors, logs,
# web-vitals, frontend traces). The frontend posts to http://localhost:<ALLOY_FARO_PORT>/collect.
# Umami = self-hosted product analytics (pageviews + custom events), replaces PostHog cloud.

#ALLOY_FARO_PORT=12347                             # Faro receiver — the frontend posts telemetry here
#ALLOY_UI_PORT=12345                               # Alloy UI — inspect the ingest pipeline while debugging

# A Umami "website" is one tracked property (your frontend). Its id is the UUID the
# browser tracking script sends as data-website-id; events with an unknown id are dropped.
# Normally you'd create the website in the UI and copy the random id it generates — instead
# we seed a website with a FIXED id below, so the frontend can hardcode it with no manual step.
# All UMAMI_* below are optional: unset = the defaults shown here (a ready-to-use admin +
# website), exactly like a normal default install.

#UMAMI_PORT=3080                                   # Umami dashboard + tracking script origin
#UMAMI_APP_SECRET=change-me-please                 # random string used to hash session IDs
#UMAMI_ADMIN_USER=admin                            # admin login, stamped onto Umami on first boot
#UMAMI_ADMIN_PASSWORD=umami                        # admin password, stamped onto Umami on first boot
#UMAMI_WEBSITE_ID=00000000-0000-4000-8000-000000000001  # fixed id → the frontend's data-website-id
#UMAMI_WEBSITE_NAME=Frontend                       # display name of the auto-created website
#UMAMI_WEBSITE_DOMAIN=localhost                    # domain shown for the website in Umami
#UMAMI_DB_NAME=umami                               # Postgres database name for Umami
#UMAMI_DB_USER=umami                               # Postgres user for Umami
#UMAMI_DB_PASSWORD=umami                           # Postgres password for Umami

# Read by the API to report frontend-observability status in GET /observability/health
# (integrations.umami / integrations.faro). Set to the public URLs the frontend uses;
# leave unset and the health endpoint simply reports them as false.
#NODE_UMAMI_HOST=http://localhost:3080             # public Umami origin (surfaced in health)
#NODE_FARO_COLLECTOR_URL=http://localhost:12347/collect  # public Faro collector (surfaced in health)


# ============================================================
#  Promtail Log Collection
# ============================================================
# The base docker-compose.yml has no host log path — each runtime adds it via its override
# (docker-compose.docker.yml / docker-compose.podman.yml). You do not pick the file here: the
# `npm run compose:*` scripts pass the right one with `-f`, chosen from the engine below.
#
# CONTAINER_ENGINE picks the runtime for every `npm run compose:*` script. Leave it unset and
# `scripts/compose.ts` uses whichever of the two is installed, preferring docker when both are —
# so SET IT if you have both installed and want podman.
#CONTAINER_ENGINE=podman
#
# Do NOT set COMPOSE_FILE in this file. Docker Compose honours it, but podman-compose ignores
# it in `.env` (verified 2026-08-05, podman-compose 1.6.0) — the override would silently fail
# to apply and Promtail would tail nothing, leaving Loki and Grafana's log panels empty.
#
# Podman only (rootless — adjust the path if you run rootful). Required for the podman override
# to resolve; harmless under Docker.
#PODMAN_CONTAINERS_PATH=/home/youruser/.local/share/containers/storage/overlay-containers


# ============================================================
#  Puppeteer / PDF Generation  (optional)
# ============================================================
# Path to the Chromium/Chrome binary used by puppeteer-core for PDF rendering.
# Defaults to /usr/bin/chromium-browser if unset.

#PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser


# ============================================================
# OTHERS
# ============================================================

# VitePress docs served by Nginx container.
# This repo owns the 3000-3099 host-port block; the paired frontend owns 8080-8099.
# Keep new services inside the block so the two stacks can run side by side.
DOCS_PORT=3090
