{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "actions": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "value": {
            "type": "string",
            "pattern": "^security(\\.[a-z_]+)+$"
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "value",
          "description"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "actions"
  ],
  "additionalProperties": false
}
