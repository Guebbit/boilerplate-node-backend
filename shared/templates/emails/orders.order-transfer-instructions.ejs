<!DOCTYPE html>
<html lang="<%= locale %>">
<%- include("../layouts/email-template-head.ejs"); %>
<body>
<main class="centered">
    <h1><%= greeting %></h1>
    <p><%= body %></p>
    <ul>
        <li><%= beneficiary %></li>
        <li><%= iban %></li>
        <% if (typeof bic !== "undefined") { %><li><%= bic %></li><% } %>
        <li><%= reference %></li>
    </ul>
    <p><%= deadline %></p>
    <p><%= total %></p>
</main>
<%- include("../layouts/default-footer.ejs"); %>
</body>
</html>
