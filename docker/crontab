# Scheduled jobs for this deployment's `cron` service (docker-compose.yml and
# docker-compose.production.yml). supercronic reads this file from `/app/crontab`.
#
# GENERATED by `npm run jobs:generate` from the `jobs` each module declares on its manifest
# (`AppModule.jobs`) and `src/app/jobs.ts` — edit a declaration, never this file. Deleting a
# module deletes its entries on the next regeneration. See docs/reference/ops.md#scheduled-jobs
# for what each job does and why it is safe to repeat.
#
# `scripts/ops/run-job.ts` gives every entry a non-zero exit on failure, closes its Mongo
# connection on both paths, and records each run's outcome for /observability/health.
#
# No output redirects: supercronic hands each job's stdout/stderr straight to its own
# (`-passthrough-logs`), which is the container's log stream Promtail ships.
# Deletes quarantined upload files past their retention window.
0 2 * * * cd /app && npm run reap:quarantine
# Deletes a stored image or thumbnail no document names, once it is over an hour old.
3 2 * * * cd /app && npm run reap:orphaned-images
# Deletes a spooled email attachment older than its retention window — a mail job died mid-flight.
30 2 * * * cd /app && npm run reap:mail-spool
# Publishes every due outbox event — the backstop for the writer's own after-commit nudge.
* * * * * cd /app && npm run sweep:outbox
# Minimises an account inactive past NODE_INACTIVE_MINIMISE_DAYS; with deletion turned on, warns, then soft-, then hard-deletes one inactive past NODE_INACTIVE_ACCOUNT_DAYS.
5 2 * * * cd /app && npm run reap:inactive-accounts
# Forgets the previous email of an account whose undo link has lapsed (sessions and one-time tokens delete themselves at their own expiry date).
7 2 * * * cd /app && npm run reap:previous-emails
# Deletes built data exports (file and row) past NODE_ACCOUNT_EXPORT_TTL_DAYS; the account can ask again.
9 2 * * * cd /app && npm run reap:account-exports
# Unsets a fulfillment order's hold note once it has not changed for its retention window.
11 2 * * * cd /app && npm run reap:delivery
# Asks the buyer of a late preorder whether to keep waiting, and announces a wait left unanswered past its deadline, which `returns` cancels and refunds.
20 2 * * * cd /app && npm run sweep:preorders
# Drains every stale checkout hold (batches of 200) and cancels the order behind each.
*/5 * * * * cd /app && npm run sweep:reservations
# Deletes stored invoice and credit-note PDFs past their retention window; the next download renders again.
8 2 * * * cd /app && npm run reap:invoice-pdfs
# Anonymizes an order's remaining PII once its retention window has passed, and unsets a timeline row's staff text once its own window has.
10 2 * * * cd /app && npm run reap:orders
# Deletes abandoned (never-settled) payment attempts past their retention window.
15 2 * * * cd /app && npm run reap:payments
# Retries refunds the provider has not answered, and settles unsettled payments whose webhook never arrived.
*/5 * * * * cd /app && npm run sweep:payment-effects
# Unsets a return's free text (`note`, `declineReason`) once the return has not changed for its retention window.
12 2 * * * cd /app && npm run reap:returns
# Answers waiting back-in-stock requests for a product that can be ordered again without any write announcing it, such as a preorder whose release date passed.
35 * * * * cd /app && npm run sweep:stock-alerts
# Reduces every expired purchase hold to the date that restarts the count of cancellations, dropping its note and who set it.
12 2 * * * cd /app && npm run reap:purchase-holds
# Re-enqueues a webhook delivery whose `nextAttemptAt` has come — the delayed-retry story's other half.
* * * * * cd /app && npm run sweep:webhook-retries
