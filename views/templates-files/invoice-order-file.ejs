<!DOCTYPE html>
<html lang="<%= locale %>">
<%- include("../layouts/pdf-template-head.ejs"); %>
<body>
<main class="centered">
    <h1><%= t('invoice.title') %></h1>
    <ul>
        <% order.items.forEach(function(item) { %>
            <li>
                <%= t('invoice.line', { title: item.product.title, quantity: item.quantity, price: item.product.price }) %>
            </li>
        <% }); %>
    </ul>
</main>
</body>
</html>
