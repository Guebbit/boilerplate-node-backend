<!doctype html>
<%#
    Operator-facing notification, not customer-facing: it goes to the support inbox, so it is
    rendered in NODE_DEFAULT_LOCALE (see post-feedback-contact.ts) rather than in the language
    of whoever filled in the form.
%>
<html lang="<%= locale %>">
    <head>
        <meta charset="UTF-8" />
        <title><%= t('email.feedback-contact.meta-title') %></title>
    </head>
    <body>
        <h2><%= t('email.feedback-contact.title') %></h2>
        <p><strong><%= t('email.feedback-contact.label-name') %>:</strong> <%= name || t('email.feedback-contact.not-available') %></p>
        <p><strong><%= t('email.feedback-contact.label-email') %>:</strong> <%= email %></p>
        <p><strong><%= t('email.feedback-contact.label-subject') %>:</strong> <%= subject %></p>
        <p><strong><%= t('email.feedback-contact.label-message') %>:</strong></p>
        <pre><%= message %></pre>
        <p><strong><%= t('email.feedback-contact.label-created-at') %>:</strong> <%= createdAt %></p>
    </body>
</html>
