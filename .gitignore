node_modules
.env*
!.env-example
.idea
dist
*.log
src/storage/invoices/*
src/storage/files/*
docs/.vitepress/cache

# Uploaded images. `public/` is served by express.static (src/app.ts), so anything a user uploads
# lands in a tracked directory — committing it would publish strangers' files with the repo.
# `seed/` is negated because those ARE repository content: the demo fixtures db/demo/index.ts
# references. Keeping fixtures in their own directory is what lets this stay two stable lines
# instead of a list of filenames to maintain.
public/images/*
!public/images/seed/

# test output
coverage

# mutation testing (stryker sandbox + html report)
.stryker-tmp

# per-run in-memory Mongo data directories (see tests/support/global-setup.ts)
.tmp

# Mutation reports are generated, EXCEPT the incremental cache, which is committed on purpose:
# Stryker reuses it to re-test only what changed, and CI can only read it if it is in the repo.
# `reports/*` and not `reports/`: git does not descend into an excluded DIRECTORY, so the negation
# below is silently dead if this loses its `*` — the file stops being committed and runs quietly
# go back to full length with nothing reporting an error.
reports/*
!reports/stryker-incremental.json

# API client collections. Generated whole from openapi.yaml on demand — `npm run contracts:bundle
# -- bruno insomnia postman` — and never read by the suite, the app or CI. Committing them put
# 1.9 MB of derived text in every diff that touched the contract, for an artefact whose only reader
# is a human about to open it in the tool. Regenerate when you want one.
contract.bruno.yml
contract.insomnia.json
contract.mockoon.json
contract.postman.json

# The compiled contract and the typed client it produces. Both are deterministic outputs of
# `npm run contracts:bundle` + `npm run gen:api` (module `openapi.yaml` fragments -> this root
# file -> api/), which `postinstall` runs automatically — see package.json. Never hand-edit
# either: a fresh clone has neither until install runs, and there is no "committed copy" left to
# go stale, which is what forgetting to regenerate used to look like.
#
# `src/modules/*/openapi.yaml` (the authored fragments) are NOT covered by this — a bare filename
# pattern without a leading slash would match those too, which is exactly the mistake to avoid.
/openapi.yaml
/api/

# Same reasoning, for the AsyncAPI side: generated by `npm run gen:asyncapi` from the committed
# asyncapi.yaml/asyncapi.public.yaml, which postinstall also runs.
src/types/asyncapi.generated.ts

# ── 2repo ────────────────────────────────────────────────────────────────────────────────────
# Everything 2repo writes: the generated repository context (`.2repo/`, `.codeboarding/`), the
# two scope files it maintains, and the `CLAUDE.md` it generates — that file is 2repo output
# here, wrapped start-to-end in its own `2repo:start`/`2repo:end` markers, not a hand-written
# instruction file.
#
# Ignored rather than committed because it is derived: 20 MB and ~730 files regenerated from
# this repo's own sources, which review cannot read and a diff cannot use. The paired frontend
# deleted its copies for the same reason, so neither side of the pair tracks any of it.
#
# Listed by hand, outside 2repo's markers, so a regeneration cannot narrow it: the block 2repo
# writes for itself covers only its caches, which would have left the other 20 MB tracked.
.2repo/
.codeboarding/
.2repoignore
.graphifyignore
CLAUDE.md
