node_modules
.env*
!.env-example
clients
.idea
dist
*.log
docs/.vitepress/cache

# Uploaded images. `public/` is served by express.static (src/app.ts), so anything a user uploads
# lands in a tracked directory — committing it would publish strangers' files with the repo.
# `seed/` and `system/` are negated because those ARE repository content: `seed/` holds the demo
# images `scenarios/products.ts` and `users.ts` reference, `system/` holds the pending-image
# placeholders the digest pipeline serves while a job is in flight (see
# docs/tools/image-processing.md). Keeping both in their own directories is what lets this stay
# stable lines instead of a list of filenames to maintain.
public/images/*
!public/images/seed/
!public/images/system/

# Every run's throwaway output, in one gitignored place: `tmp/coverage` (jest coverage),
# `tmp/reports` (test reports, mutation reports, mutation-shard reports, audit findings),
# `tmp/stryker` (Stryker's own per-run sandbox copy of the whole project), `tmp/test` (per-run
# in-memory Mongo data directories and file sandboxes — see tests/support/global-setup.ts),
# `tmp/quarantine` (an upload pending processing — src/infrastructure/adapters/image-store.ts)
# and `tmp/storage` (the invoice cache and the mail spool — src/modules/orders/config.ts,
# src/infrastructure/adapters/mail-spool.ts).
#
# `quarantine` and `storage` are the exception to "throwaway": NODE_QUARANTINE_PATH,
# NODE_INVOICE_CACHE_PATH and NODE_MAIL_SPOOL_PATH each point a real deployment at a durable
# mounted volume instead — the unset default living under `tmp/` is a local-dev convenience,
# not the thing carrying the durability guarantee there.
tmp

# Written and removed around one assertion in self-barrel-import.test.ts; ignored so a crash
# mid-test never leaves it tracked.
src/modules/*/__self-barrel-probe.ts
src/modules/*/__factories-import-probe.ts

# Claude Code's local state: session settings, and the worktrees it creates under
# `.claude/worktrees/` — which `jest.config.js` already excludes from every test run. None of it
# describes the project, so none of it is shared. `commands/` is the one exception: those slash
# commands are checked in deliberately.
/.claude/*
!/.claude/commands/

# The optional symlink that exposes tests/audit/*.md as Claude Code slash commands — see
# docs/tools/ai-auditing.md. The prompts themselves are versioned; this is one developer's
# convenience, regenerable with a single ln -s.
/.claude/commands/audit

# API client collections. Generated whole from openapi.yaml on demand — `npm run contracts:bundle
# -- bruno insomnia postman` — and never read by the suite, the app or CI. Committing them put
# 1.9 MB of derived text in every diff that touched the contract, for an artefact whose only reader
# is a human about to open it in the tool. Regenerate when you want one.
contract.bruno.yml
contract.insomnia.json
contract.mockoon.json
contract.postman.json

# The compiled contract and the typed client it produces. Both are deterministic outputs of
# `npm run contracts:bundle` + `npm run gen:api` (module `openapi.yaml` fragments -> this root
# file -> api/), which `postinstall` runs automatically — see package.json. Never hand-edit
# either: a fresh clone has neither until install runs, and there is no "committed copy" left to
# go stale, which is what forgetting to regenerate used to look like.
#
# `src/modules/*/openapi.yaml` (the authored fragments) are NOT covered by this — a bare filename
# pattern without a leading slash would match those too, which is exactly the mistake to avoid.
/openapi.yaml
/api/

# Same reasoning, for the AsyncAPI side: generated by `npm run gen:asyncapi` from the committed
# asyncapi.yaml/asyncapi.public.yaml, which postinstall also runs.
src/types/asyncapi.generated.ts

# Root-level Markdown is WORKING NOTES: a plan, an audit, a handover, written for one change and
# deleted when it lands.
/*.md
!/README.md
!/CLAUDE.md

# 2brain:start — regenerate with: 2brain <repo-path>
.2brain/graphify-out/cache/
.2brain/graphify-out/graph.json
.2brain/graphify-out/manifest.json
.2brain/graphify-out/.graphify_analysis.json
.2brain/graphify-out/.graphify_labels.json*
.2brain/graphify-out/graph.html
.2brain/graphify-out/[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]/
.2brain/modules/.modules-cache.json
.2brain/repo-index.json
.codeboarding/
# 2brain:end
