<!DOCTYPE html>
<html lang="<%= locale %>">
<%- include("/shared/templates/layouts/pdf-template-head.ejs"); %>
<body>
<main class="centered">
    <h1><%= title %></h1>
    <% if (typeof reversalNotice !== 'undefined' && reversalNotice) { %>
        <p><em><%= reversalNotice %></em></p>
    <% } %>

    <% if (typeof meta !== 'undefined' && meta) { %>
        <p><%= meta.numberLabel %></p>
        <p><%= meta.dateLabel %></p>
    <% } %>

    <% if (typeof billing !== 'undefined' && billing) { %>
        <address>
            <div><%= billing.fullName %></div>
            <% billing.lines.forEach(function(line) { %>
                <div><%= line %></div>
            <% }); %>
        </address>
    <% } %>

    <%- include("./invoicing.document.vat-table.ejs", { columns: vat.columns, rows: vat.rows, showQuantity: true }); %>
    <% if (vat.shipping) { %>
        <h2><%= vat.shipping.title %></h2>
        <%- include("./invoicing.document.vat-table.ejs", { columns: vat.columns, rows: vat.shipping.rows, showQuantity: false }); %>
    <% } %>

    <h2><%= vat.summaryTitle %></h2>
    <%- include("./invoicing.document.vat-table.ejs", { columns: vat.columns, rows: vat.summaryRows, showQuantity: false }); %>

    <p><%= vat.netTotalLabel %>: <%= vat.netTotal %></p>
    <p><%= vat.taxTotalLabel %>: <%= vat.taxTotal %></p>
    <p><strong><%= vat.grandTotalLabel %>: <%= vat.grandTotal %></strong></p>

    <address>
        <% if (vat.supplier.legalName) { %>
            <div><%= vat.supplier.legalName %></div>
        <% } %>
        <% if (vat.supplier.address) { %>
            <div><%= vat.supplier.address %></div>
        <% } %>
        <div><%= vat.supplier.vatNumberLine %></div>
    </address>
</main>
</body>
</html>
