<%# One rate-grouped breakdown (the shipping rows, or the VAT summary): `title` over net, VAT and total. %>
<table class="summary">
    <thead>
        <tr>
            <th class="caption"><%= title %></th>
            <th class="caption num"><%= columns.net %></th>
            <th class="caption num"><%= columns.tax %></th>
            <th class="caption num"><%= columns.gross %></th>
        </tr>
    </thead>
    <tbody>
        <% rows.forEach(function(row) { %>
            <tr>
                <td><%= row.description %></td>
                <td class="num"><%= row.netAmount %></td>
                <td class="num"><%= row.taxAmount %></td>
                <td class="num"><%= row.grossAmount %></td>
            </tr>
        <% }); %>
    </tbody>
</table>
