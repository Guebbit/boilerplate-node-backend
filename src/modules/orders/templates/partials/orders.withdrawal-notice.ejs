<section class="withdrawal">
    <h2><%= withdrawalHeading %></h2>
    <% withdrawalTerms.forEach(function (paragraph) { %><p><%= paragraph %></p>
    <% }); %>
    <% if (withdrawalEffects.length > 0) { %>
    <h3><%= withdrawalEffectsHeading %></h3>
    <% withdrawalEffects.forEach(function (paragraph) { %><p><%= paragraph %></p>
    <% }); %>
    <h2><%= withdrawalFormHeading %></h2>
    <% withdrawalForm.forEach(function (row) { %><p><%= row %></p>
    <% }); %>
    <% } %>
</section>
