<!DOCTYPE html>
<html lang="<%= locale %>">
<%- include("/shared/templates/layouts/email-template-head.ejs"); %>
<body>
<main class="centered">
    <h1><%= greeting %></h1>
    <p><%= body %></p>
    <ul>
        <li><%= beneficiary %></li>
        <li><%= iban %></li>
        <% if (typeof bic !== "undefined") { %><li><%= bic %></li><% } %>
        <li><%= reference %></li>
    </ul>
    <p><%= deadline %></p>
    <p><%= total %></p>
    <p><a href="<%= linkUrl %>"><%= linkLabel %></a></p>
    <%- include("./partials/orders.withdrawal-notice.ejs"); %>
</main>
<%- include("/shared/templates/layouts/default-footer.ejs"); %>
</body>
</html>
