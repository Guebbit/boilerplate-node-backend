<!doctype html>
<%#
    Staff-facing, so it skips the buyer's footer. Its copy is resolved per recipient in their own
    locale by `modules/notifications/emails.ts`; this file only interpolates.
%>
<html lang="<%= locale %>">
    <head>
        <meta charset="UTF-8" />
        <title><%= pageMetaTitle %></title>
    </head>
    <body>
        <h2><%= title %></h2>
        <p><%= summary %></p>
        <p><a href="<%= link %>"><%= linkLabel %></a></p>
    </body>
</html>
