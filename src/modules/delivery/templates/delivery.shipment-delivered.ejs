<!DOCTYPE html>
<html lang="<%= locale %>">
<%- include("/shared/templates/layouts/email-template-head.ejs"); %>
<body>
<main class="centered">
    <h1><%= greeting %></h1>
    <p><%= body %></p>
    <% if (typeof lines !== "undefined" && lines.length > 0) { %><ul><% lines.forEach(function (line) { %><li><%= line %></li><% }) %></ul><% } %>
    <% if (typeof withdraw !== "undefined") { %><p><%= withdraw %></p><% } %>
</main>
<%- include("/shared/templates/layouts/default-footer.ejs"); %>
</body>
</html>
