{
    "name": "boilerplate-node-api-mongodb-mongoose",
    "version": "3.0.0",
    "main": "src/main.ts",
    "license": "AGPL-3.0-or-later",
    "scripts": {
        "setup": "tsx scripts/setup/index.ts",
        "dev": "tsx watch src/main.ts",
        "dev:docker": "nodemon --legacy-watch --watch src --ext ts --exec 'tsx src/main.ts'",
        "dev:docker:cluster": "nodemon --legacy-watch --watch src --ext ts --exec 'tsx src/cluster.ts'",
        "start": "node --import tsx src/main.ts",
        "start:cluster": "cross-env NODE_ENABLE_CLUSTERING=1 node --import tsx src/cluster.ts",
        "e2e:serve": "cross-env NODE_E2E_RUN=1 tsx src/main.ts",
        "demo": "tsx scenarios/run-server.ts",
        "debug": "tsx --inspect-brk src/main.ts",
        "host": "cross-env NODE_DB_URI= NODE_MONGODB_HOST=127.0.0.1 NODE_REDIS_URL= NODE_REDIS_HOST=127.0.0.1 npm run",
        "ts-check": "tsc --noEmit",
        "lint": "eslint --max-warnings 0",
        "lint:fix": "eslint --fix",
        "lint:openapi": "spectral lint --ruleset shared/contracts/spectral.yaml openapi.yaml",
        "lint:openapi:modules": "spectral lint --ruleset shared/contracts/spectral.modules.yaml src/modules/*/openapi.yaml",
        "lint:asyncapi": "tsx scripts/contracts/validate-asyncapi.ts asyncapi.yaml asyncapi.public.yaml",
        "lint:asyncapi:names": "spectral lint --ruleset shared/contracts/spectral.asyncapi.names.yaml asyncapi.yaml",
        "lint:asyncapi:modules": "spectral lint --ruleset shared/contracts/spectral.asyncapi.modules.yaml src/modules/*/asyncapi.yaml shared/contracts/asyncapi.workers.yaml",
        "prettier:check": "prettier . --check",
        "prettier:fix": "prettier . --write",
        "contracts:bundle": "tsx scripts/contracts/build-bundles.ts",
        "check": "tsx scripts/regenerate-artifacts.ts --check && tsx scripts/contracts/check-asyncapi-breaking.ts && tsx scripts/pairing/check-spec-identity.ts && tsx scripts/docs/check-references.ts && depcruise src tests --output-type err && depcruise src/modules --config .dependency-cruiser.modules.cjs --output-type err && depcruise scripts/contracts/build-bundles.ts --config .dependency-cruiser.bootstrap.cjs --output-type err",
        "sync:frontend": "tsx scripts/pairing/sync-to-frontend.ts",
        "regenerate": "tsx scripts/regenerate-artifacts.ts",
        "check:generated": "tsx scripts/hooks/check-generated-fresh.ts",
        "gen:permission-vocabulary": "tsx scripts/contracts/generate-permission-vocabulary.ts --in shared/authorization-keys.generated.yaml --out api/permission-vocabulary.ts",
        "gen:api": "rm -rf ./api && orval --config orval.config.ts && tsx scripts/contracts/generate-error-codes.ts --out api/error-codes.ts && tsx scripts/contracts/generate-request-content-types.ts --out api/request-content-types.ts && tsx scripts/contracts/generate-upload-types.ts --out api/upload-types.ts && tsx scripts/contracts/generate-redirect-query.ts --out api/redirect-query.ts && npm run gen:permission-vocabulary",
        "gen:asyncapi": "tsx scripts/contracts/generate-asyncapi-types.ts --out src/types/asyncapi.generated.ts",
        "test": "npm run test:unit && npm run test:cross-cutting && npm run test:integration && npm run test:contract && npm run test:fuzz",
        "test:unit": "tsx scripts/testing/run-suite.ts unit",
        "test:cross-cutting": "tsx scripts/testing/run-suite.ts cross-cutting",
        "scaffold:module": "tsx scripts/scaffold/scaffold-module.ts",
        "measure:scaffold": "tsx scripts/testing/measure-scaffold.ts",
        "demo:remove": "tsx scripts/scaffold/demo-remove.ts",
        "test:integration": "tsx scripts/testing/run-suite.ts integration",
        "test:contract": "tsx scripts/testing/run-suite.ts contract",
        "test:contract:cookie": "cross-env NODE_SESSION_MODE=cookie tsx scripts/testing/run-suite.ts contract",
        "test:journeys:cookie": "cross-env NODE_SESSION_MODE=cookie jest --runInBand tests/integration/journeys",
        "test:fuzz": "tsx scripts/testing/run-suite.ts fuzz",
        "test:staged": "tsx scripts/testing/run-staged-tests.ts",
        "test:order-random": "tsx scripts/testing/run-suite.ts integration contract fuzz --unsharded --runInBand --randomize --showSeed",
        "mutation": "tsx scripts/mutation/run-diff.ts",
        "mutation:full": "tsx scripts/mutation/run-shards.ts",
        "mutation:check": "tsx scripts/mutation/check-baseline.ts",
        "mutation:pull": "tsx scripts/mutation/pull-report.ts",
        "audit:shallow": "tsx scripts/audit/code-shape/scripts/generate-shallow-candidates.ts",
        "audit:unused": "knip --no-progress --no-exit-code",
        "audit:duplicates": "jscpd",
        "audit:check-clean": "tsx scripts/audit/run-check-clean.ts",
        "audit:test-candidates": "eslint --no-config-lookup -c scripts/audit/test-honesty/eslint.candidates.config.ts -f json",
        "test:prism": "tsx scripts/testing/run-prism-smoke-test.ts",
        "test:cluster": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.config.cluster.js",
        "test:broker": "jest --config jest.config.broker.js",
        "bench": "sh -c '${CONTAINER_ENGINE:-podman} run --rm -i --network=host -e TARGET=\"http://localhost:${NODE_PORT:-3000}${1:-/products}\" -e TOKEN -e VUS -e DURATION -v ./tests/load:/scripts:Z grafana/k6:1.8.1 run /scripts/hit.js' --",
        "db:sync": "tsx scripts/db/sync-indexes.ts",
        "scenario:apply": "tsx scenarios/apply.ts",
        "scenario:images": "tsx scenarios/tools/generate-seed-images.ts",
        "scenario:tls": "tsx scenarios/tools/generate-webhook-sink-tls.ts",
        "scenario:apply:reset": "tsx scenarios/apply.ts --reset",
        "db:cache:clear": "tsx scripts/db/cache-clear.ts",
        "db:bootstrap": "npm run db:sync -- --prune && npm run scenario:apply",
        "access:bootstrap": "tsx scripts/db/bootstrap-access.ts",
        "deploy:setup": "npm run db:sync && npm run access:bootstrap",
        "config:check": "tsx scripts/ops/check-config.ts",
        "job": "tsx scripts/ops/run-job.ts",
        "reencrypt": "tsx scripts/ops/reencrypt.ts",
        "ops:reapply-erasures": "tsx scripts/ops/reapply-erasures.ts",
        "refresh:breached-passwords": "tsx scripts/security/refresh-breached-passwords.ts",
        "compose": "${CONTAINER_ENGINE:-podman} compose",
        "compose:up": "npm run compose -- up -d",
        "compose:up:full": "npm run compose -- --profile observability --profile analytics --profile docs up -d",
        "compose:restart": "npm run compose -- down && npm run compose -- up -d",
        "compose:rebuild": "npm run compose -- down -v && npm run compose -- build --no-cache && npm run compose -- up -d",
        "backup:drill": "bash docker/backup/drill.sh",
        "deploy:drill": "bash docker/deploy-drill.sh",
        "docs:dev": "vitepress dev docs",
        "docs:build": "vitepress build docs",
        "docs:preview": "vitepress preview docs",
        "complete:static": "npm run lint && npm run prettier:check && npm run complete:static:gates",
        "complete:static:gates": "npm run ts-check && npm run lint:openapi && npm run lint:openapi:modules && npm run lint:asyncapi && npm run lint:asyncapi:names && npm run lint:asyncapi:modules && npm run check",
        "complete": "npm run complete:static && npm run docs:build && npm run test",
        "complete:fix": "npm run lint:fix && npm run prettier:fix && npm run complete",
        "complete:manual": "npm run test:prism && npm run test:cluster && npm run test:broker",
        "complete:light": "npm run lint && npm run prettier:check && npm run complete:light:gates",
        "complete:light:gates": "npm run complete:static:gates && npm run test:unit && npm run test:cross-cutting",
        "postinstall": "tsx scripts/docs/generate-scenario-registries.ts && tsx scripts/contracts/authorization-bundle.ts && npm run gen:permission-vocabulary && tsx scripts/contracts/generate-shared-rule-schemas.ts && npm run contracts:bundle && npm run gen:api && npm run gen:asyncapi",
        "prepare": "husky",
        "test:unit:report": "tsx scripts/testing/run-suite.ts unit cross-cutting --unsharded --json --outputFile=tmp/reports/test-report.json",
        "test:report": "tsx scripts/testing/report-results.ts",
        "bench:k6": "sh -c '${CONTAINER_ENGINE:-podman} run --rm -i --network=host -e BASE_URL -v ./tests/load:/scripts:Z grafana/k6:1.8.1 run \"/scripts/${1:-browse}.js\"' --"
    },
    "devDependencies": {
        "@asyncapi/diff": "^0.6.1",
        "@asyncapi/modelina": "^5.10.1",
        "@asyncapi/parser": "^3.6.6",
        "@babel/plugin-transform-modules-commonjs": "^7.29.7",
        "@commitlint/cli": "^21.2.4",
        "@commitlint/config-conventional": "^21.2.4",
        "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
        "@eslint/js": "^10.0.1",
        "@guebbit/openapi-runnable-collections": "^0.1.0",
        "@mdit-vue/shared": "^4.0.0",
        "@redocly/cli": "^2.77.0",
        "@sinonjs/fake-timers": "^15.4.0",
        "@stoplight/prism-cli": "^5.16.0",
        "@stoplight/spectral-cli": "^6.17.1",
        "@stoplight/spectral-formatters": "^1.6.0",
        "@stoplight/spectral-rulesets": "1.22.7",
        "@stryker-mutator/core": "^10.1.1",
        "@stryker-mutator/jest-runner": "^10.1.1",
        "@swc/core": "^1.16.22",
        "@swc/jest": "^0.2.39",
        "@types/cookie-parser": "^1.4.10",
        "@types/cors": "^2.8.19",
        "@types/ejs": "^3.1.5",
        "@types/express": "^5.0.6",
        "@types/jest": "^30.0.0",
        "@types/multer": "^2.3.0",
        "@types/node": "^26.6.6",
        "@types/supertest": "^7.2.1",
        "@typescript-eslint/eslint-plugin": "^8.72.1",
        "@typescript-eslint/parser": "^8.72.1",
        "@typescript-eslint/utils": "^8.72.1",
        "cross-env": "^10.1.0",
        "dependency-cruiser": "^18.7.2",
        "eslint": "^10.14.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-import-resolver-typescript": "^4.4.5",
        "eslint-plugin-boundaries": "^7.4.2",
        "eslint-plugin-jest": "^29.17.0",
        "eslint-plugin-jsdoc": "^65.4.5",
        "eslint-plugin-regexp": "^3.3.3",
        "eslint-plugin-unicorn": "^80.0.0",
        "fast-check": "^4.10.2",
        "globals": "^17.14.0",
        "husky": "^9.1.7",
        "jest": "^30.5.2",
        "jest-environment-node": "^30.5.2",
        "jiti": "^2.7.0",
        "jscpd": "^5.4.3",
        "knip": "^6.44.2",
        "lint-staged": "^17.6.0",
        "mermaid": "^12.3.0",
        "minimatch": "^11.0.1",
        "mongodb-memory-server": "^11.3.0",
        "nodemon": "^3.1.14",
        "openapi-types": "^12.1.3",
        "orval": "^8.47.0",
        "prettier": "^3.9.10",
        "supertest": "^7.3.2",
        "ts-jest": "^29.4.15",
        "typescript": "~6.0.0",
        "typescript-eslint": "^8.72.1",
        "vitepress": "^1.6.4"
    },
    "dependencies": {
        "@casl/ability": "^7.1.1",
        "@casl/mongoose": "^9.1.0",
        "@guebbit/js-toolkit": "^2.3.0",
        "@opentelemetry/api": "^1.10.0",
        "@opentelemetry/core": "^3.1.0",
        "@opentelemetry/exporter-trace-otlp-http": "^0.301.0",
        "@opentelemetry/instrumentation-express": "^0.73.0",
        "@opentelemetry/instrumentation-http": "^0.301.0",
        "@opentelemetry/instrumentation-mongoose": "^0.71.0",
        "@opentelemetry/instrumentation-redis": "^0.73.0",
        "@opentelemetry/resources": "^3.1.0",
        "@opentelemetry/sdk-node": "^0.301.0",
        "@opentelemetry/sdk-trace": "^3.1.0",
        "@opentelemetry/semantic-conventions": "^1.45.0",
        "altcha-lib": "^2.8.0",
        "amqplib": "^2.3.1",
        "bowser": "^2.15.0",
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.6",
        "csv-stringify": "^6.9.0",
        "disposable-email-domains-js": "^1.26.0",
        "dotenv": "^18.0.10",
        "ejs": "^7.0.2",
        "express": "^5.3.0",
        "express-rate-limit": "^8.7.3",
        "helmet": "^8.3.0",
        "i18next": "^27.1.3",
        "ibantools": "^4.5.4",
        "ipaddr.js": "^2.5.0",
        "jose": "^6.2.16",
        "mongodb": "^7.1.1",
        "mongodb-connection-string-url": "^7.0.2",
        "mongoose": "^9.12.0",
        "multer": "^2.5.0",
        "nodemailer": "^10.4.0",
        "openid-client": "^6.8.9",
        "otplib": "^13.6.0",
        "posthog-node": "^5.63.2",
        "prom-client": "^15.1.3",
        "puppeteer-core": "^25.16.0",
        "rate-limit-redis": "^6.0.2",
        "redis": "^6.3.1",
        "sharp": "0.35.5",
        "sitemap": "^10.0.0",
        "tsx": "^4.23.15",
        "winston": "^3.19.0",
        "yaml": "^2.8.1",
        "zod": "^4.3.6"
    },
    "overrides": {
        "ip-address": "^10.7.4",
        "jsonpath-plus": "^10.4.0",
        "@faker-js/faker": "^10.6.0",
        "lodash": "^4.18.1",
        "postman-collection": {
            "@faker-js/faker": "5.5.3"
        }
    },
    "engines": {
        "node": ">=24.15",
        "npm": ">=11.16.0"
    },
    "config": {
        "mongodbMemoryServer": {
            "version": "9.0.4"
        }
    },
    "allowScripts": {
        "mongodb-memory-server": true,
        "protobufjs": false,
        "fsevents": true,
        "unrs-resolver": true,
        "@hyperjump/json-pointer": true,
        "@hyperjump/json-schema": true,
        "@hyperjump/json-schema-core": true,
        "@hyperjump/pact": true,
        "@scarf/scarf": false,
        "@parcel/watcher": false,
        "@swc/core": true,
        "esbuild": true
    }
}
