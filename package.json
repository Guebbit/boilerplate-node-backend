{
    "name": "boilerplate-node-api-mongodb-mongoose",
    "version": "2.0.0",
    "main": "src/cluster.ts",
    "license": "AGPLv3.0",
    "scripts": {
        "dev": "tsx watch src/cluster.ts",
        "dev:docker": "nodemon --legacy-watch --watch src --ext ts --exec 'tsx src/app.ts'",
        "dev:docker:cluster": "nodemon --legacy-watch --watch src --ext ts --exec 'tsx src/cluster.ts'",
        "start": "tsx src/cluster.ts",
        "demo": "tsx scripts/run-demo-server.ts",
        "debug": "tsx --inspect-brk src/cluster.ts",
        "host": "cross-env NODE_DB_URI= NODE_MONGODB_HOST=127.0.0.1 NODE_REDIS_URL= NODE_REDIS_HOST=127.0.0.1 npm run",
        "ts-check": "tsc --noEmit",
        "build": "npm run ts-check && npm run lint",
        "lint": "eslint --max-warnings 0",
        "lint:fix": "eslint --fix",
        "lint:openapi": "spectral lint openapi.yaml",
        "lint:openapi:modules": "spectral lint --ruleset spectral.modules.yaml src/modules/*/openapi.yaml",
        "lint:asyncapi": "asyncapi validate asyncapi.yaml && asyncapi validate asyncapi.public.yaml",
        "lint:asyncapi:modules": "spectral lint --ruleset spectral.asyncapi.modules.yaml src/modules/*/asyncapi.yaml shared/contracts/asyncapi.workers.yaml",
        "prettier:check": "prettier . --check",
        "prettier:fix": "prettier . --write",
        "contracts:bundle": "tsx scripts/build-contract-bundles.ts",
        "check:contracts-bundle": "tsx scripts/build-contract-bundles.ts --check",
        "check:spec-identity": "tsx scripts/check-spec-identity.ts",
        "check:environment-keys": "tsx scripts/check-environment-keys.ts",
        "check:dependencies": "depcruise src --output-type err",
        "sync:frontend": "tsx scripts/sync-shared-files-to-frontend.ts --regen",
        "regenerate": "tsx scripts/regenerate-artifacts.ts",
        "gen:api": "rm -rf ./api && orval --config orval.config.ts",
        "gen:asyncapi": "tsx scripts/generate-asyncapi-types.ts --out src/types/asyncapi.generated.ts",
        "check:asyncapi-types": "tsx scripts/generate-asyncapi-types.ts --check --out src/types/asyncapi.generated.ts",
        "test": "npm run test:unit && npm run test:cross-cutting && npm run test:integration && npm run test:contract && npm run test:fuzz",
        "test:unit": "jest tests/unit 'src/modules/.*/tests/unit'",
        "test:cross-cutting": "jest tests/cross-cutting",
        "test:unit:coverage": "jest tests/unit tests/cross-cutting 'src/modules/.*/tests/unit' --coverage --runInBand",
        "test:integration": "jest tests/integration --runInBand",
        "test:contract": "jest tests/contract 'src/modules/.*/tests/contract' --runInBand",
        "test:fuzz": "jest tests/fuzz --runInBand",
        "test:all": "jest",
        "test:mutation": "tsx scripts/run-mutation-tests.ts",
        "test:mutation:check": "tsx scripts/check-mutation-baseline.ts",
        "test:mutation:baseline": "tsx scripts/check-mutation-baseline.ts --update",
        "test:prism": "tsx scripts/run-prism-smoke-test.ts",
        "test:cluster": "jest --config jest.config.cluster.js",
        "bench": "autocannon -c 20 -d 30 -l http://localhost:${NODE_PORT:-3000}/products",
        "bench:search": "autocannon -c 20 -d 30 -l -m POST -H 'Content-Type: application/json' -b '{\"text\":\"a\"}' http://localhost:${NODE_PORT:-3000}/products/search",
        "setup:mongod": "docker create --name mongo-temp mongo:latest && docker cp mongo-temp:/usr/bin/mongod /tmp/mongod && docker rm mongo-temp",
        "db:migrate:up": "migrate-mongo up",
        "db:migrate:down": "migrate-mongo down",
        "db:migrate:status": "migrate-mongo status",
        "db:seed": "tsx db/demo/index.ts",
        "seed:export": "tsx scripts/export-demo-dataset.ts",
        "check:seed-export": "tsx scripts/export-demo-dataset.ts --check",
        "db:seed:reset": "tsx db/demo/index.ts --reset",
        "db:cache:clear": "tsx db/cache-clear.ts",
        "db:bootstrap": "npm run db:migrate:up && npm run db:seed",
        "compose": "${CONTAINER_ENGINE:-podman} compose",
        "compose:restart": "npm run compose -- down && npm run compose -- up -d",
        "compose:rebuild": "npm run compose -- down -v && npm run compose -- build --no-cache && npm run compose -- up -d",
        "compose:kill": "npm run compose -- kill",
        "docs:dev": "vitepress dev docs",
        "docs:build": "vitepress build docs",
        "docs:preview": "vitepress preview docs",
        "docs:asyncapi": "asyncapi start studio asyncapi.yaml",
        "update:all": "npm-check-updates -u",
        "complete": "npm run ts-check && npm run lint && npm run lint:openapi && npm run lint:openapi:modules && npm run lint:asyncapi && npm run lint:asyncapi:modules && npm run prettier:check && npm run check:contracts-bundle && npm run check:asyncapi-types && npm run check:seed-export && npm run check:spec-identity && npm run check:environment-keys && npm run check:dependencies && npm run test",
        "complete:fix": "npm run ts-check && npm run lint:fix && npm run lint && npm run lint:openapi && npm run lint:openapi:modules && npm run lint:asyncapi && npm run lint:asyncapi:modules && npm run prettier:fix && npm run check:contracts-bundle && npm run check:asyncapi-types && npm run check:seed-export && npm run check:spec-identity && npm run check:environment-keys && npm run check:dependencies && npm run test",
        "complete:manual": "npm run test:prism && npm run test:cluster",
        "prepare": "husky",
        "test:unit:report": "jest tests/unit tests/cross-cutting \"src/modules/.*/tests/unit\" --json --outputFile=reports/test-report.json",
        "test:report": "tsx scripts/report-test-results.ts",
        "test:module": "jest --runInBand",
        "bench:orders": "autocannon -c 20 -d 30 -l http://localhost:${NODE_PORT:-3000}/orders",
        "bench:inventory": "autocannon -c 20 -d 30 -l http://localhost:${NODE_PORT:-3000}/inventory/levels",
        "bench:k6": "k6 run k6/browse.js",
        "bench:k6:checkout": "k6 run k6/checkout.js"
    },
    "devDependencies": {
        "@asyncapi/cli": "^6.0.2",
        "@asyncapi/modelina": "^5.10.1",
        "@commitlint/cli": "^21.2.1",
        "@commitlint/config-conventional": "^21.2.0",
        "@eslint-community/eslint-plugin-eslint-comments": "^4.7.2",
        "@eslint/js": "^9.39.5",
        "@guebbit/openapi-runnable-collections": "file:../openapi-runnable-collections",
        "@redocly/cli": "^2.46.1",
        "@stoplight/prism-cli": "^5.6.0",
        "@stoplight/spectral-cli": "^6.15.0",
        "@stoplight/spectral-rulesets": "^1.22.0",
        "@stryker-mutator/core": "^9.6.1",
        "@stryker-mutator/jest-runner": "^9.6.1",
        "@swc/core": "^1.15.47",
        "@swc/jest": "^0.2.39",
        "@types/amqplib": "^0.10.8",
        "@types/bcrypt": "^6.0.0",
        "@types/cookie-parser": "^1.4.10",
        "@types/cors": "^2.8.19",
        "@types/ejs": "^3.1.5",
        "@types/express": "^5.0.6",
        "@types/jest": "^30.0.0",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/multer": "^2.1.0",
        "@types/node": "^25.5.0",
        "@types/nodemailer": "^7.0.11",
        "@types/supertest": "^7.2.1",
        "@typescript-eslint/eslint-plugin": "^8.54.0",
        "@typescript-eslint/parser": "^8.56.1",
        "autocannon": "^8.0.0",
        "cross-env": "^10.1.0",
        "dependency-cruiser": "^18.2.0",
        "eslint": "^9.39.2",
        "eslint-config-prettier": "^10.1.8",
        "eslint-import-resolver-typescript": "^4.4.5",
        "eslint-plugin-boundaries": "^7.2.0",
        "eslint-plugin-prettier": "^5.5.5",
        "eslint-plugin-unicorn": "^63.0.0",
        "fast-check": "^4.9.0",
        "globals": "^17.4.0",
        "husky": "^9.1.7",
        "jest": "^30.3.0",
        "jest-openapi": "^0.14.2",
        "jiti": "^2.6.1",
        "mermaid": "^11.14.0",
        "migrate-mongo": "^14.0.7",
        "mongodb-memory-server": "^11.0.1",
        "nodemon": "^3.1.14",
        "npm-check-updates": "^22.2.3",
        "orval": "^8.17.0",
        "prettier": "^3.8.1",
        "supertest": "^7.2.2",
        "ts-jest": "^29.4.6",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.56.1",
        "vitepress": "^1.6.4",
        "vitepress-plugin-mermaid": "^2.0.17",
        "yaml": "^2.8.1"
    },
    "dependencies": {
        "@guebbit/js-toolkit": "^2.1.0",
        "@opentelemetry/api": "^1.9.1",
        "@opentelemetry/exporter-trace-otlp-http": "^0.220.0",
        "@opentelemetry/instrumentation-express": "^0.64.0",
        "@opentelemetry/instrumentation-http": "^0.220.0",
        "@opentelemetry/instrumentation-mongoose": "^0.63.0",
        "@opentelemetry/instrumentation-redis": "^0.65.0",
        "@opentelemetry/sdk-node": "^0.220.0",
        "@opentelemetry/semantic-conventions": "^1.40.0",
        "amqplib": "^2.0.1",
        "bcrypt": "^6.0.0",
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.6",
        "dotenv": "^17.3.1",
        "ejs": "^5.0.1",
        "express": "^5.2.1",
        "express-rate-limit": "^8.3.1",
        "helmet": "^8.1.0",
        "i18next": "^25.10.9",
        "jsonwebtoken": "^9.0.3",
        "mongodb": "^7.1.1",
        "mongoose": "^9.3.3",
        "multer": "^2.1.1",
        "nodemailer": "^9.0.3",
        "posthog-node": "^5.33.0",
        "prom-client": "^15.1.3",
        "puppeteer-core": "^24.40.0",
        "rate-limit-redis": "^6.0.1",
        "redis": "^5.12.1",
        "tsx": "^4.21.0",
        "winston": "^3.19.0",
        "zod": "^4.3.6"
    },
    "allowScripts": {
        "file:../../../openapi-runnable-collections": true
    }
}
