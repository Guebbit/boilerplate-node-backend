{
    "name": "boilerplate-node-api-mongodb-mongoose",
    "version": "3.0.0",
    "main": "src/cluster.ts",
    "license": "AGPL-3.0-or-later",
    "scripts": {
        "setup": "tsx scripts/setup/index.ts",
        "dev": "cross-env NODE_EXTRA_CA_CERTS=scenarios/support/tls/webhook-sink-ca.pem tsx watch --import ./scenarios/support/development-doubles.ts src/cluster.ts",
        "dev:docker": "nodemon --legacy-watch --watch src --ext ts --exec 'tsx --import ./scenarios/support/development-doubles.ts src/serve.ts'",
        "dev:docker:cluster": "nodemon --legacy-watch --watch src --ext ts --exec 'tsx --import ./scenarios/support/development-doubles.ts src/cluster.ts'",
        "start": "tsx src/cluster.ts",
        "e2e:serve": "cross-env NODE_E2E_RUN=1 NODE_EXTRA_CA_CERTS=scenarios/support/tls/webhook-sink-ca.pem tsx --import ./scenarios/support/development-doubles.ts src/cluster.ts",
        "demo": "cross-env NODE_EXTRA_CA_CERTS=scenarios/support/tls/webhook-sink-ca.pem tsx --import ./scenarios/support/development-doubles.ts scenarios/run-server.ts",
        "debug": "tsx --inspect-brk --import ./scenarios/support/development-doubles.ts src/cluster.ts",
        "host": "cross-env NODE_DB_URI= NODE_MONGODB_HOST=127.0.0.1 NODE_REDIS_URL= NODE_REDIS_HOST=127.0.0.1 npm run",
        "ts-check": "tsc --noEmit",
        "build": "npm run ts-check && npm run lint",
        "lint": "eslint --max-warnings 0",
        "lint:fix": "eslint --fix",
        "lint:openapi": "spectral lint --ruleset shared/contracts/spectral.yaml openapi.yaml",
        "lint:openapi:modules": "spectral lint --ruleset shared/contracts/spectral.modules.yaml src/modules/*/openapi.yaml",
        "lint:asyncapi": "tsx scripts/contracts/validate-asyncapi.ts asyncapi.yaml asyncapi.public.yaml",
        "lint:asyncapi:modules": "spectral lint --ruleset shared/contracts/spectral.asyncapi.modules.yaml src/modules/*/asyncapi.yaml shared/contracts/asyncapi.workers.yaml",
        "prettier:check": "prettier . --check",
        "prettier:fix": "prettier . --write",
        "contracts:bundle": "tsx scripts/contracts/build-bundles.ts",
        "check:contracts-bundle": "tsx scripts/contracts/build-bundles.ts --check",
        "authorization:bundle": "tsx scripts/contracts/authorization-bundle.ts",
        "check:authorization-bundle": "tsx scripts/contracts/authorization-bundle.ts --check",
        "check:asyncapi-breaking": "tsx scripts/contracts/check-asyncapi-breaking.ts",
        "check:spec-identity": "tsx scripts/pairing/check-spec-identity.ts",
        "check:dependencies": "depcruise src tests --output-type err && depcruise src/modules --config .dependency-cruiser.modules.cjs --output-type err && depcruise scripts/contracts/build-bundles.ts --config .dependency-cruiser.bootstrap.cjs --output-type err",
        "docs:graph": "tsx scripts/docs/generate-module-graph.ts",
        "docs:roles": "tsx scripts/docs/generate-role-matrix.ts",
        "docs:dependencies": "tsx scripts/docs/generate-dependency-map.ts",
        "docs:rate-limits": "tsx scripts/docs/generate-rate-limit-budgets.ts",
        "docs:config": "tsx scripts/docs/generate-config-reference.ts",
        "docs:audit-actions": "tsx scripts/docs/generate-audit-actions.ts",
        "docker:dockerignore": "tsx scripts/docker/generate-dockerfile-dockerignore.ts",
        "check:docs-graph": "tsx scripts/docs/generate-module-graph.ts --check",
        "check:docs-roles": "tsx scripts/docs/generate-role-matrix.ts --check",
        "check:docs-dependencies": "tsx scripts/docs/generate-dependency-map.ts --check",
        "check:docs-rate-limits": "tsx scripts/docs/generate-rate-limit-budgets.ts --check",
        "check:docs-config": "tsx scripts/docs/generate-config-reference.ts --check",
        "check:env-example": "tsx scripts/docs/check-environment-example.ts",
        "check:docs-audit-actions": "tsx scripts/docs/generate-audit-actions.ts --check",
        "check:docs-references": "tsx scripts/docs/check-references.ts",
        "check:docker-dockerignore": "tsx scripts/docker/generate-dockerfile-dockerignore.ts --check",
        "sync:frontend": "tsx scripts/pairing/sync-to-frontend.ts",
        "regenerate": "tsx scripts/regenerate-artifacts.ts",
        "gen:permission-actions": "tsx scripts/contracts/generate-permission-actions.ts --in shared/authorization-keys.yaml --out api/permission-actions.ts",
        "gen:api": "rm -rf ./api && orval --config orval.config.ts && tsx scripts/contracts/generate-error-codes.ts --out api/error-codes.ts && tsx scripts/contracts/generate-request-content-types.ts --out api/request-content-types.ts && tsx scripts/contracts/generate-permission-actions.ts --in shared/authorization-keys.yaml --out api/permission-actions.ts",
        "gen:asyncapi": "tsx scripts/contracts/generate-asyncapi-types.ts --out src/types/asyncapi.generated.ts",
        "test": "npm run test:unit && npm run test:cross-cutting && npm run test:integration && npm run test:contract && npm run test:fuzz",
        "test:unit": "tsx scripts/testing/run-suite.ts unit",
        "test:cross-cutting": "tsx scripts/testing/run-suite.ts cross-cutting",
        "scaffold:module": "tsx scripts/scaffold/scaffold-module.ts",
        "measure:scaffold": "tsx scripts/testing/measure-scaffold.ts",
        "measure:demo-strip": "tsx scripts/testing/measure-demo-strip.ts",
        "demo:remove": "tsx scripts/ops/demo-remove.ts",
        "test:unit:coverage": "cross-env NODE_OPTIONS=--max-old-space-size=4096 tsx scripts/testing/run-suite.ts unit cross-cutting --unsharded --coverage",
        "test:integration": "tsx scripts/testing/run-suite.ts integration",
        "test:contract": "tsx scripts/testing/run-suite.ts contract",
        "test:fuzz": "tsx scripts/testing/run-suite.ts fuzz",
        "test:order-random": "tsx scripts/testing/run-suite.ts integration contract fuzz --unsharded --runInBand --randomize --showSeed",
        "mutation": "tsx scripts/mutation/run-diff.ts",
        "mutation:full": "tsx scripts/mutation/run-shards.ts",
        "mutation:check": "tsx scripts/mutation/check-baseline.ts",
        "mutation:pull": "tsx scripts/mutation/pull-baseline.ts",
        "test:prism": "tsx scripts/testing/run-prism-smoke-test.ts",
        "test:cluster": "jest --config jest.config.cluster.js",
        "test:broker": "jest --config jest.config.broker.js",
        "bench": "autocannon -c 20 -d 30 -l http://localhost:${NODE_PORT:-3000}/products",
        "bench:search": "autocannon -c 20 -d 30 -l -m POST -H 'Content-Type: application/json' -b '{\"text\":\"a\"}' http://localhost:${NODE_PORT:-3000}/products/search",
        "db:sync": "tsx scripts/db/sync-indexes.ts",
        "scenario:apply": "tsx scenarios/apply.ts",
        "scenario:images": "tsx scenarios/tools/generate-seed-images.ts",
        "scenario:tls": "tsx scenarios/tools/generate-webhook-sink-tls.ts",
        "scenario:apply:reset": "tsx scenarios/apply.ts --reset",
        "db:cache:clear": "tsx scripts/db/cache-clear.ts",
        "db:bootstrap": "npm run db:sync && npm run scenario:apply",
        "access:bootstrap": "tsx scripts/db/bootstrap-access.ts",
        "deploy:setup": "npm run db:sync && npm run access:bootstrap",
        "reap:quarantine": "tsx scripts/ops/reap-quarantine.ts",
        "reap:mail-spool": "tsx scripts/ops/reap-mail-spool.ts",
        "reap:inactive-accounts": "tsx scripts/ops/reap-inactive-accounts.ts",
        "reap:account-exports": "tsx scripts/ops/reap-account-exports.ts",
        "reap:expired-tokens": "tsx scripts/ops/reap-expired-tokens.ts",
        "reap:invoice-pdfs": "tsx scripts/ops/reap-invoice-pdfs.ts",
        "reap:orders": "tsx scripts/ops/reap-orders.ts",
        "reencrypt": "tsx scripts/ops/reencrypt.ts",
        "reap:payments": "tsx scripts/ops/reap-payments.ts",
        "sweep:order-effects": "tsx scripts/ops/sweep-order-effects.ts",
        "sweep:outbox": "tsx scripts/ops/sweep-outbox.ts",
        "sweep:webhook-retries": "tsx scripts/ops/sweep-webhook-retries.ts",
        "sweep:payment-effects": "tsx scripts/ops/sweep-payment-effects.ts",
        "sweep:reservations": "tsx scripts/ops/sweep-reservations.ts",
        "refresh:breached-passwords": "tsx scripts/ops/refresh-breached-passwords.ts",
        "reap:orphaned-images": "tsx scripts/ops/reap-orphaned-images.ts",
        "compose": "${CONTAINER_ENGINE:-podman} compose",
        "compose:up": "npm run compose -- up -d",
        "compose:up:full": "npm run compose -- --profile observability --profile analytics --profile docs up -d",
        "compose:restart": "npm run compose -- down && npm run compose -- up -d",
        "compose:rebuild": "npm run compose -- down -v && npm run compose -- build --no-cache && npm run compose -- up -d",
        "compose:kill": "npm run compose -- kill",
        "docs:dev": "vitepress dev docs",
        "docs:build": "vitepress build docs",
        "docs:preview": "vitepress preview docs",
        "update:all": "npm-check-updates -u",
        "complete:static": "npm run ts-check && npm run lint && npm run lint:openapi && npm run lint:openapi:modules && npm run lint:asyncapi && npm run lint:asyncapi:modules && npm run prettier:check && npm run check:contracts-bundle && npm run check:authorization-bundle && npm run check:asyncapi-breaking && npm run check:spec-identity && npm run check:dependencies && npm run check:docs-graph && npm run check:docs-roles && npm run check:docs-dependencies && npm run check:docs-rate-limits && npm run check:docs-config && npm run check:env-example && npm run check:docs-audit-actions && npm run check:docs-references && npm run check:docker-dockerignore",
        "complete": "npm run complete:static && npm run docs:build && npm run test",
        "complete:fix": "npm run lint:fix && npm run prettier:fix && npm run complete",
        "complete:manual": "npm run test:prism && npm run test:cluster && npm run test:broker",
        "complete:light": "npm run complete:static && npm run test:unit && npm run test:cross-cutting",
        "postinstall": "npm run gen:permission-actions && npm run contracts:bundle && npm run gen:api && npm run gen:asyncapi",
        "prepare": "husky",
        "test:unit:report": "tsx scripts/testing/run-suite.ts unit cross-cutting --unsharded --json --outputFile=tmp/reports/test-report.json",
        "test:report": "tsx scripts/testing/report-results.ts",
        "test:module": "jest --runInBand",
        "bench:orders": "autocannon -c 20 -d 30 -l http://localhost:${NODE_PORT:-3000}/orders",
        "bench:inventory": "autocannon -c 20 -d 30 -l http://localhost:${NODE_PORT:-3000}/inventory/levels",
        "bench:k6": "${CONTAINER_ENGINE:-podman} run --rm -i --network=host -v ./tests/load:/scripts:Z grafana/k6 run /scripts/browse.js",
        "bench:k6:checkout": "${CONTAINER_ENGINE:-podman} run --rm -i --network=host -v ./tests/load:/scripts:Z grafana/k6 run /scripts/checkout.js"
    },
    "devDependencies": {
        "@asyncapi/diff": "^0.5.0",
        "@asyncapi/modelina": "^5.10.1",
        "@asyncapi/parser": "^3.6.3",
        "@babel/plugin-transform-modules-commonjs": "^7.29.7",
        "@commitlint/cli": "^21.2.3",
        "@commitlint/config-conventional": "^21.2.0",
        "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
        "@eslint/js": "^10.0.1",
        "@guebbit/openapi-runnable-collections": "^0.1.0",
        "@redocly/cli": "^2.57.0",
        "@sinonjs/fake-timers": "^15.4.0",
        "@stoplight/prism-cli": "^5.16.0",
        "@stoplight/spectral-cli": "^6.16.3",
        "@stoplight/spectral-formatters": "^1.5.1",
        "@stoplight/spectral-rulesets": "1.22.7",
        "@stryker-mutator/core": "^10.0.0",
        "@stryker-mutator/jest-runner": "^10.0.0",
        "@swc/core": "^1.16.13",
        "@swc/jest": "^0.2.39",
        "@types/amqplib": "^0.10.8",
        "@types/cookie-parser": "^1.4.10",
        "@types/cors": "^2.8.19",
        "@types/ejs": "^3.1.5",
        "@types/express": "^5.0.6",
        "@types/jest": "^30.0.0",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/multer": "^2.3.0",
        "@types/node": "^24.19.0",
        "@types/sinonjs__fake-timers": "^15.0.1",
        "@types/supertest": "^7.2.1",
        "@typescript-eslint/eslint-plugin": "^8.71.0",
        "@typescript-eslint/parser": "^8.71.0",
        "@typescript-eslint/utils": "^8.71.0",
        "autocannon": "^8.0.0",
        "cross-env": "^10.1.0",
        "dependency-cruiser": "^18.5.0",
        "eslint": "^10.11.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-import-resolver-typescript": "^4.4.5",
        "eslint-plugin-boundaries": "^7.2.0",
        "eslint-plugin-jest": "^29.16.6",
        "eslint-plugin-jsdoc": "^64.3.6",
        "eslint-plugin-prettier": "^5.5.6",
        "eslint-plugin-unicorn": "^76.0.0",
        "fast-check": "^4.10.2",
        "globals": "^17.4.0",
        "husky": "^9.1.7",
        "jest": "^30.5.2",
        "jest-environment-node": "^30.3.0",
        "jiti": "^2.7.0",
        "mermaid": "^11.14.0",
        "minimatch": "^10.2.6",
        "mongodb-memory-server": "^11.3.0",
        "nodemon": "^3.1.14",
        "npm-check-updates": "^22.2.3",
        "orval": "^8.39.0",
        "prettier": "^3.9.9",
        "supertest": "^7.3.0",
        "ts-jest": "^29.4.14",
        "typescript": "~6.0.0",
        "typescript-eslint": "^8.71.0",
        "vitepress": "^1.6.4",
        "vitepress-plugin-mermaid": "^2.0.17"
    },
    "dependencies": {
        "@casl/ability": "^7.0.1",
        "@casl/mongoose": "^9.0.2",
        "@guebbit/js-toolkit": "^2.3.0",
        "@opentelemetry/api": "^1.9.1",
        "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
        "@opentelemetry/instrumentation-express": "^0.70.0",
        "@opentelemetry/instrumentation-http": "^0.222.0",
        "@opentelemetry/instrumentation-mongoose": "^0.68.0",
        "@opentelemetry/instrumentation-redis": "^0.70.0",
        "@opentelemetry/resources": "^2.11.0",
        "@opentelemetry/sdk-node": "^0.222.0",
        "@opentelemetry/sdk-trace": "^2.11.0",
        "@opentelemetry/semantic-conventions": "^1.43.0",
        "altcha-lib": "^2.5.0",
        "amqplib": "^2.2.0",
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.6",
        "disposable-email-domains-js": "^1.26.0",
        "dotenv": "^17.3.1",
        "ejs": "^6.0.1",
        "express": "^5.2.1",
        "express-rate-limit": "^8.7.0",
        "helmet": "^8.3.0",
        "i18next": "^26.4.2",
        "ibantools": "^4.5.4",
        "ipaddr.js": "^2.5.0",
        "jsonwebtoken": "^9.0.3",
        "mongodb": "^7.7.0",
        "mongodb-connection-string-url": "^7.0.2",
        "mongoose": "^9.10.3",
        "multer": "^2.4.0",
        "nodemailer": "^10.0.13",
        "otplib": "^13.5.0",
        "posthog-node": "^5.55.0",
        "prom-client": "^15.1.3",
        "puppeteer-core": "^25.12.0",
        "rate-limit-redis": "^6.0.1",
        "redis": "^6.3.0",
        "sharp": "0.35.5",
        "tsx": "^4.23.15",
        "winston": "^3.19.0",
        "yaml": "^2.9.1",
        "zod": "^4.6.5"
    },
    "overrides": {
        "ip-address": "^10.7.2",
        "jsonpath-plus": "^10.4.0",
        "@faker-js/faker": "^10.6.0",
        "lodash": "^4.18.1",
        "postman-collection": {
            "@faker-js/faker": "5.5.3"
        }
    },
    "engines": {
        "node": ">=24.7",
        "npm": ">=11.16.0"
    },
    "allowScripts": {
        "mongodb-memory-server@11.0.1": true,
        "protobufjs@7.6.6": true,
        "fsevents@2.3.3": true,
        "unrs-resolver@1.11.1": true,
        "@hyperjump/json-pointer@0.9.8": true,
        "@hyperjump/json-schema@0.23.5": true,
        "@hyperjump/json-schema-core@0.28.5": true,
        "@hyperjump/pact@0.2.5": true,
        "@scarf/scarf": false,
        "@swc/core@1.15.47": true,
        "esbuild@0.27.7": true,
        "esbuild@0.21.5": true,
        "esbuild@0.28.2": true
    }
}
