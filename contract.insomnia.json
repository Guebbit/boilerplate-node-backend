          id: req_e0abd2ff9ac323c4dbe0cfed199cdce5
          created: 1767225600000
          modified: 1767225600000
          isPrivate: false
          description: Adds an entry to the authenticated user's address book. The first entry becomes the default automatically; a later entry claims the default slot only by sending `default true`, which demotes the previous holder.
          sortKey: 3009
        method: POST
        body:
          mimeType: application/json
          text: |-
            {
              "label": "string",
              "fullName": "string",
              "street": "string",
              "city": "string",
              "zip": "string",
              "country": "string",
              "phone": "string",
              "default": true
