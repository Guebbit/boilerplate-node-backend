        method: PUT
        body:
          mimeType: application/json
          text: |-
            {
              "email": "gino@pino.it",
              "username": "ginopinoshow",
              "locale": "it",
              "imageUrl": "/images/seed/ad2e01890eebf72d06481c4fac3522ac.jpg"
